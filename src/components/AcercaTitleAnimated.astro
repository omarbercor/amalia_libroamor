---
// AcercaTitleAnimated.astro - Título "COSAS QUE NO ESTÁN EN EL LIBRO PERO DEBERÍAN" con subrayado animado
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`acerca-title-wrapper ${className}`}>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 760 255" 
    class="acerca-title-svg" 
    aria-label="Cosas que no están en el libro pero deberían"
  >
    <!-- Textos con Amaliafont_altas -->
    <g class="acerca-title-texts">
      <text class="acerca-title-line" x="380" y="52" text-anchor="middle">
        COSAS QUE NO
      </text>
      <text class="acerca-title-line" x="380" y="125" text-anchor="middle">
        ESTÁN EN EL LIBRO
      </text>
      <text class="acerca-title-line" x="380" y="198" text-anchor="middle">
        PERO DEBERÍAN
      </text>
    </g>

    <!-- Subrayados rojos con efecto pincel / plumón imperfecto -->
    <g class="acerca-title-underlines">
      <!-- Subrayado línea 2 -->
      <path 
        class="acerca-underline-path underline-1"
        d="M 125,142 Q 380,137 635,146"
        fill="none"
        stroke="#EE2A22"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <!-- Subrayado línea 3 -->
      <path 
        class="acerca-underline-path underline-2"
        d="M 100,218 Q 380,212 660,225"
        fill="none"
        stroke="#EE2A22"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </g>
  </svg>
</div>

<style>
  .acerca-title-wrapper {
    width: 100%;
    max-width: 720px;
    display: flex;
    justify-content: center;
  }

  .acerca-title-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .acerca-title-line {
    fill: var(--color-marker-red, #EE2A22);
    font-family: 'Amaliafont_altas-Regular', 'Amaliafont_altas', sans-serif;
    font-size: 58px;
    font-weight: normal;
    letter-spacing: 0.03em;
  }

  .acerca-underline-path {
    stroke: var(--color-marker-red, #EE2A22);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

  gsap.registerPlugin(DrawSVGPlugin);

  function initAcercaTitle() {
    const lines = document.querySelectorAll('.acerca-underline-path');
    if (!lines.length) return;

    gsap.set(lines, { drawSVG: '0%' });
    gsap.to(lines, {
      drawSVG: '100%',
      duration: 1.2,
      stagger: 0.25,
      delay: 0.2,
      ease: 'power2.out'
    });
  }

  document.addEventListener('DOMContentLoaded', initAcercaTitle);
  document.addEventListener('astro:page-load', initAcercaTitle);
</script>
