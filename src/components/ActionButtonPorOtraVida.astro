---
// ActionButtonPorOtraVida.astro - Botón con caja roja y textos vectoriales trazados
interface Props {
  href?: string;
  class?: string;
}

const { href = "/o-por-otra-vida", class: className = "" } = Astro.props;
---

<a href={href} class={`home-action-btn btn-stretch-por-otra-vida ${className}`} aria-label="O por otra vida">
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 276.2 110.8"
    class="action-btn-svg"
    aria-hidden="true"
  >
    <defs>
      <clipPath id="clippath-btn2">
        <rect y="0" width="276.2" height="110.8" fill="none"/>
      </clipPath>
    </defs>
    <!-- Capa 1: Fondo contenedor rojo -->
    <g id="btn2_container" class="btn-box-group" clip-path="url(#clippath-btn2)">
      <path 
        id="btn2_bg" 
        class="btn-bg-path" 
        fill="#ee2a22" 
        d="M254.5,106.5c4.2-.4,8.6-1,11.8-3.5,3.7-2.8,4.9-7.5,5.9-11.8,5.5-23.8,3.8-47.7,3.8-72.1s-5.9-15.3-14.6-15.8C192-.4,86.7-1.8,17.7,3.5c-5.3.4-11.3,1.2-14.4,5.2-2.1,2.7-2.3,6.3-2.5,9.7C-.2,41.5-.1,73.8.3,96.9c0,6.4,5.6,11.8,12.5,12.2,37.8,2.6,191.8,2.3,241.7-2.7"
      />
    </g>

    <!-- Capa 2: Trazos vectoriales de texto "O POR OTRA VIDA" ordenados de izquierda a derecha -->
    <g id="btn2_text_group" class="btn-text-strokes" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="5">
      <!-- O -->
      <path class="btn-text-stroke" d="M21.5,54.1s-4.1-.6-4.5,5.6,3.4,8.5,3.4,8.5c0,0,4.9,1.1,5.6-6,.7-7.4-3.9-8.5-5.4-8.6"/>

      <!-- P -->
      <path class="btn-text-stroke" d="M42,60.2s6.4,1.6,7.6-4.1c0,0,1.4-6.8-6.6-6.2l-2.6,21"/>
      <!-- O -->
      <path class="btn-text-stroke" d="M61,50.3s-5,2-5.3,10.5,4.9,7.9,4.9,7.9c0,0,5.1-.3,4.4-9.6s-3.3-8.4-4.7-8.4"/>
      <!-- R (asta) -->
      <path class="btn-text-stroke" d="M77.2,47.6s-.6,15-2.9,22.6"/>
      <!-- R (bucle + pierna) -->
      <path class="btn-text-stroke" d="M78.1,47.6s1.9-3.3,6.1-1.2c6.3,3.2.7,11.3-5.5,7.6l2.4.9,10.9,13.8"/>

      <!-- O -->
      <path class="btn-text-stroke" d="M115.6,51.3s-6,.6-5.4,8.9,7.1,7.8,7.1,7.8c0,0,5.7-1.8,5.1-9s-5.5-8.4-7.1-8.1"/>
      <!-- T (barra horizontal) -->
      <path class="btn-text-stroke" d="M127.6,50.8s7.9.8,15.7.4"/>
      <!-- T (asta vertical) -->
      <path class="btn-text-stroke" d="M136.2,71.7s-1.2-16.5-.8-20.2"/>
      <!-- R (asta) -->
      <path class="btn-text-stroke" d="M151.9,49.5s-.2,14.2-1.5,22.5"/>
      <!-- R (bucle + pierna) -->
      <path class="btn-text-stroke" d="M152.8,49.5s1.9-3.3,6.1-1.2c6.3,3.2.7,11.3-5.5,7.6l2.4.9,9.7,13.8"/>
      <!-- A (diagonal + pierna) -->
      <path class="btn-text-stroke" d="M169.9,67.9s3.8-16.7,5.5-19.6,3-6.1,3.8,1.4c.8,7.5,3.3,19.5,3.3,19.5"/>
      <!-- A (travesaño) -->
      <line class="btn-text-stroke" x1="172.2" y1="61.3" x2="179.5" y2="60.3"/>

      <!-- V -->
      <path class="btn-text-stroke" d="M204.8,50.3s.1.3.1.4,4.1,11.9,5,15.2c0,0,1.6,6.7,3-1.1s2.5-12.9,2.6-13.2.8-2.9.8-2.9"/>
      <!-- I -->
      <path class="btn-text-stroke" d="M223.9,49.8v.5c0,.2-.6,14.4-.6,14.8,0,1.1,0,3.6,0,3.6"/>
      <!-- D -->
      <path class="btn-text-stroke" d="M233.5,48.2s-.2,14-1.1,21.1c0,0,10.6-.3,11.5-11.2.8-9.5-10.8-9.5-10.8-9.5"/>
      <!-- A (diagonal + pierna) -->
      <path class="btn-text-stroke" d="M249.1,70.2l6.4-21.7s1.9-4.7,2.7,2.8,2.5,20,2.5,20"/>
      <!-- A (travesaño) -->
      <line class="btn-text-stroke" x1="251.9" y1="61.8" x2="258.9" y2="61.7"/>
    </g>
  </svg>
</a>

<style>
  .btn-stretch-por-otra-vida {
    display: inline-block;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .btn-stretch-por-otra-vida:hover {
    transform: scale(1.2);
  }

  .btn-stretch-por-otra-vida:hover .btn-bg-path {
    fill: #000000;
  }

  .btn-stretch-por-otra-vida:active {
    transform: scale(1.15);
  }

  .action-btn-svg {
    width: 180px;
    max-width: 180px;
    height: auto;
    display: block;
    overflow: visible;
  }

  .btn-box-group {
    transform-origin: center;
  }

  .btn-bg-path {
    transition: fill 0.25s ease;
  }

  .btn-text-stroke {
    stroke: #ffffff;
  }

  @media (max-width: 860px) {
    .action-btn-svg {
      width: 260px;
      max-width: 260px;
    }
  }
</style>
