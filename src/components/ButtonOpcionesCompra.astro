      <path d="M79.6,13.1s1.9-2.8,5.3-2.3,1.8,4.8-2.3,5.5l4.5,7.1"/>
      <path d="M270.3,11s-1.4,11.6-3,17"/>
      <path d="M270.5,12.4s1.3-2.3,4.3-.8c4.4,2.3.5,7.9-3.9,5.4l1.7.6,7.6,10.8"/>
      <path d="M283,25.7l4.8-13.7s1.3-3.3,1.9,2,1,12.5,1,12.5"/>
      <line x1="284.9" y1="20.4" x2="290" y2="19.7"/>
      <path d="M208.7,11.8c0,0-5.2.7-5.8.8s-3.1-.1-3.1-.1"/>
      <path d="M129.5,11.8v.4c0,.2-1.6,11.2-1.7,11.4,0,.8,0,2.5,0,2.5"/>
      <path d="M52.7,11.3s0,.2,0,.3.7,10.3,1.7,11.8c0,0,.7,4.7,2.5-1.3,1.4-4.8,2.9-10,3-10.2s.8-1.8.8-1.8"/>
      <path d="M186.1,10.5s.3,2.9-1.3,14.9c0,0-.7,2,1.8,1s5.8-2.1,6.3-7.1-4.4-7.7-7.2-7.9"/>
