  </svg>
</a>

<style>
  .btn-svg-compra {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s ease;
    width: 100%;
    max-width: 340px;
  }

  .btn-svg-compra:hover {
    transform: scale(1.04);
    filter: drop-shadow(0 6px 14px rgba(238, 42, 34, 0.3));
  }

  .btn-svg-compra:active {
    transform: scale(0.98);
  }

  .opciones-compra-svg {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
