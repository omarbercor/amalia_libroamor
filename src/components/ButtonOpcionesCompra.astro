---
// ButtonOpcionesCompra.astro - Botón con caja roja y trazos SVG de 'VER OPCIONES DE COMPRA'
interface Props {
  href?: string;
  class?: string;
}

const { href = "/compra", class: className = "" } = Astro.props;
---

<a href={href} class={`btn-svg-compra ${className}`} aria-label="Ver opciones de compra">
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 339.8 37.2" 
    class="opciones-compra-svg" 
    aria-hidden="true"
  >
    <defs>
      <clipPath id="clippath-opciones-compra">
        <rect width="339.8" height="37.2" fill="none"/>
      </clipPath>
    </defs>
    <!-- Fondo rojo con forma irregular rasgada -->
    <g id="Layer_1">
      <g id="Grupo_125">
        <g clip-path="url(#clippath-opciones-compra)">
          <g id="Grupo_86">
            <path 
              class="btn-pill-bg" 
              fill="#EE2A22" 
              d="M1.3,4.4C1.7,2.2,8.2.5,15.8.6,70.1,1.3,253.3.3,329.4,0c3.2,0,6.8,0,8.8.7,1.6.6,1.6,1.4,1.6,2.1-.8,9.3-1.6,18.7-2.4,28-.1,1.4-.3,2.8-3,4-4.6,2-14.3,2.1-22.5,2.1-96-.4-294,1.6-303.3-1.3C-1.9,32.4-.6,14.6,1.3,4.4"
            />
          </g>
        </g>
      </g>
    </g>
    <!-- Trazos vectoriales blancos de las letras -->
    <g id="Layer_2" fill="none" stroke="#FFFFFF" stroke-linecap="round" stroke-linejoin="round" stroke-width="3">
      <path d="M143.2,25.6l1.7-11.3s3.9,9.7,4.4,10.2,2-11,2-11"/>
      <path d="M137.6,14s-3.1-.4-4.4,5.3c-1.3,5.7,2.1,6.2,2.1,6.2,0,0,3.2.4,4.3-4.5s-1.1-7.2-2.1-7.3"/>
