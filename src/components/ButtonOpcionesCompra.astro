      <path d="M177.4,15.2s-3.3-2.9-6.4-1.6c-.7.2-3,1.6-2.6,3.3s1.5,2.7,4.6,3c3.9.3,3.6,1.8,3.6,2.2s-.8,2.2-4.7,2.5c0,0-1,0-1.2-.3"/>
      <path d="M163.7,24c-.4.3-3.7,1.1-3.7,1.1-3.9,1-2.9-1.4-2.9-1.4l1.6-8.9s4.9-.4,6.4-1.1"/>
