---
// Footer.astro - Footer con Logo Planeta, Copyright y Políticas/Privacidad en rojo (#EE2A22)
// Mobile:
//   1. Logo Planeta
//   2. Políticas / Privacidad (rojo)
//   3. Copyright (rojo)
//
// Desktop:
//   Logo Planeta + Copyright (izq) | Políticas / Privacidad (der, bottom)
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<footer class={`site-footer ${className}`}>
  <div class="footer-inner">
    <!-- Desktop Columna 1: Logo Editorial Planeta + Copyright -->
    <div class="footer-col footer-col-left">
      <div class="planeta-logo-box">
        <a href="https://www.planetadelibros.com" target="_blank" rel="noopener noreferrer" class="planeta-link" aria-label="Editorial Planeta">
          <img 
            src="/assets/home/EditorialPlaneta.svg.webp" 
            alt="Editorial Planeta" 
            class="planeta-logo-img"
            width="135"
            height="35"
            loading="lazy"
          />
        </a>
      </div>
      <p class="copyright-text desktop-copy">
        Copyright &copy; 2026 Planeta. Todos los derechos reservados.
      </p>
    </div>

    <!-- Desktop Columna 2: Políticas / Privacidad alineadas al bottom -->
    <div class="footer-col footer-col-right">
      <nav class="legal-nav" aria-label="Enlaces legales">
        <a href="/politica-de-cookies" class="legal-link">Política de cookies</a>
        <span class="divider" aria-hidden="true">/</span>
        <a href="/politica-de-privacidad" class="legal-link">Política de privacidad</a>
      </nav>
    </div>

    <!-- Mobile Copyright (visible solo en mobile como último elemento) -->
    <div class="mobile-copy-block">
      <p class="copyright-text">
        Copyright &copy; 2026 Planeta. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0.5rem;
    z-index: 10;
  }

  /* Desktop Layout:
     Alineación al bottom (align-items: flex-end)
     Logo Planeta + Copyright (izq) | Políticas / Privacidad (der)
  */
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    gap: 1.5rem;
  }

  /* Columna Izquierda: Logo Planeta + Copyright */
  .footer-col-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .planeta-logo-box {
    display: flex;
    align-items: center;
  }

  .planeta-logo-img {
    height: 24px;
    width: auto;
    display: block;
  }

  /* Textos en Rojo (#EE2A22) */
  .copyright-text {
    font-family: var(--font-regular);
    font-size: 0.75rem;
    color: var(--color-primary-red);
    margin: 0;
    line-height: 1.3;
  }

  .desktop-copy {
    display: block;
  }

  .mobile-copy-block {
    display: none;
  }

  /* Columna Derecha: Políticas / Privacidad en Rojo y alineadas al bottom */
  .footer-col-right {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 2px;
  }

  .legal-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-regular);
    font-size: 0.78rem;
    color: var(--color-primary-red);
  }

  .legal-link {
    color: var(--color-primary-red);
    text-decoration: none;
    transition: opacity var(--transition-smooth);
  }

  .legal-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .divider {
    color: var(--color-primary-red);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* MOBILE LAYOUT (< 768px):
     1. Logo Planeta
     2. Políticas / Privacidad
     3. Copyright
     Todo centrado y con textos en rojo
  */
  @media (max-width: 768px) {
    .site-footer {
      padding-top: 0;
      padding-bottom: 1rem;
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      gap: 0.85rem;
    }

    /* 1. Logo Planeta */
    .footer-col-left {
      order: 1;
      align-items: center;
    }

    .desktop-copy {
      display: none;
    }

    .planeta-logo-img {
      height: 22px;
    }

    /* 2. Políticas / Privacidad */
    .footer-col-right {
      order: 2;
      justify-content: center;
      align-items: center;
      padding-bottom: 0;
    }

    .legal-nav {
      justify-content: center;
      font-size: 0.76rem;
      gap: 0.5rem;
    }

    /* 3. Copyright */
    .mobile-copy-block {
      display: block;
      order: 3;
    }

    .mobile-copy-block .copyright-text {
      font-size: 0.72rem;
    }
  }
</style>
