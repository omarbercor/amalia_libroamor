---
// Footer.astro - Footer con textos e iconos en rojo (#EE2A22) y alineados al bottom
// Mobile:
//   1. Logo Planeta
//   2. RRSS (rojo)
//   3. Políticas / Privacidad (rojo)
//   4. Copyright (rojo)
//
// Desktop:
//   Logo Planeta + Copyright (izq) | RRSS (centro, bottom) | Políticas / Privacidad (der, bottom)
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<footer class={`site-footer ${className}`}>
  <div class="footer-inner">
    <!-- Desktop Columna 1: Logo Editorial Planeta + Copyright -->
    <div class="footer-col footer-col-left">
      <div class="planeta-logo-box">
        <a href="https://www.planetadelibros.com" target="_blank" rel="noopener noreferrer" class="planeta-link" aria-label="Editorial Planeta">
          <img 
            src="/assets/home/EditorialPlaneta.svg.webp" 
            alt="Editorial Planeta" 
            class="planeta-logo-img"
            width="135"
            height="35"
            loading="lazy"
          />
        </a>
      </div>
      <p class="copyright-text desktop-copy">
        Copyright &copy; 2026 Planeta. Todos los derechos reservados.
      </p>
    </div>

    <!-- Desktop Columna 2: Redes Sociales (RRSS) alineadas al bottom -->
    <div class="footer-col footer-col-center">
      <div class="social-links" aria-label="Redes sociales">
        <!-- Facebook -->
        <a href="https://facebook.com/amaliaandrade" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
          </svg>
        </a>
        <!-- Instagram -->
        <a href="https://instagram.com/amaliaandrade_" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <!-- X / Twitter -->
        <a href="https://x.com/amaliaandrade_" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="X">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Desktop Columna 3: Políticas / Privacidad alineadas al bottom -->
    <div class="footer-col footer-col-right">
      <nav class="legal-nav" aria-label="Enlaces legales">
        <a href="#cookies" class="legal-link">Política de cookies</a>
        <span class="divider" aria-hidden="true">/</span>
        <a href="#privacidad" class="legal-link">Política de privacidad</a>
      </nav>
    </div>

    <!-- Mobile Copyright (visible solo en mobile como 4to elemento) -->
    <div class="mobile-copy-block">
      <p class="copyright-text">
        Copyright &copy; 2026 Planeta. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0.5rem;
    z-index: 10;
  }

  /* Desktop Layout:
     Alineación al bottom (align-items: flex-end)
     Logo Planeta + Copyright (izq) | RRSS (centro) | Políticas / Privacidad (der)
  */
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: flex-end;
    width: 100%;
    gap: 1.5rem;
  }

  /* Columna Izquierda: Logo Planeta + Copyright */
  .footer-col-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .planeta-logo-box {
    display: flex;
    align-items: center;
  }

  .planeta-logo-img {
    height: 24px;
    width: auto;
    display: block;
  }

  /* Textos en Rojo (#EE2A22) */
  .copyright-text {
    font-family: var(--font-regular);
    font-size: 0.75rem;
    color: var(--color-primary-red);
    margin: 0;
    line-height: 1.3;
  }

  .desktop-copy {
    display: block;
  }

  .mobile-copy-block {
    display: none;
  }

  /* Columna Centro: RRSS en Rojo y alineadas al bottom */
  .footer-col-center {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 2px;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .social-icon {
    color: var(--color-primary-red);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .social-icon:hover {
    color: #000000;
  }

  /* Columna Derecha: Políticas / Privacidad en Rojo y alineadas al bottom */
  .footer-col-right {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 2px;
  }

  .legal-nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-regular);
    font-size: 0.78rem;
    color: var(--color-primary-red);
  }

  .legal-link {
    color: var(--color-primary-red);
    text-decoration: none;
    transition: opacity var(--transition-smooth);
  }

  .legal-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .divider {
    color: var(--color-primary-red);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* MOBILE LAYOUT (< 768px):
     1. Logo Planeta
     2. RRSS
     3. Políticas / Privacidad
     4. Copyright
     Todo centrado y con textos/íconos en rojo
  */
  @media (max-width: 768px) {
    .site-footer {
      padding-top: 0;
      padding-bottom: 1rem;
    }

    .footer-inner {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    /* 1. Logo Planeta */
    .footer-col-left {
      order: 1;
      align-items: center;
    }

    .desktop-copy {
      display: none;
    }

    .planeta-logo-img {
      height: 22px;
    }

    /* 2. RRSS */
    .footer-col-center {
      order: 2;
      align-items: center;
      padding-bottom: 0;
    }

    .social-links {
      gap: 1.5rem;
    }

    /* 3. Políticas / Privacidad */
    .footer-col-right {
      order: 3;
      justify-content: center;
      align-items: center;
      padding-bottom: 0;
    }

    .legal-nav {
      justify-content: center;
      font-size: 0.76rem;
      gap: 0.5rem;
    }

    /* 4. Copyright */
    .mobile-copy-block {
      display: block;
      order: 4;
    }

    .mobile-copy-block .copyright-text {
      font-size: 0.72rem;
    }
  }
</style>
