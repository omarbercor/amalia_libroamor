---
// InteractiveSharpieCanvas.astro
// Módulo interactivo de dibujo libre inspirado en codepen.io/bradarnett/pen/XyZKaG
// El plumón reemplaza exactamente la foto estática en la esquina inferior derecha.
// Hover: se levanta a -5°.
// Click / Drag: se inclina a -20° (+-5°) y dibuja sobre el canvas (situado debajo del contenido para no bloquear clics).
// Release: regresa suavemente con animación fluida a su posición original de reposo.
// Los trazos se desvanecen gradualmente a los 3s.
---

<div class="interactive-sharpie-wrapper" id="sharpieWrapper">
  <!-- Canvas de dibujo interactivo: z-index bajo para estar DEBAJO del contenido interactivo -->
  <canvas id="sharpieCanvas" class="sharpie-canvas"></canvas>

  <!-- Plumón físico que ocupa el lugar de la foto en la esquina inferior derecha -->
  <div id="sharpieMarker" class="sharpie-marker-unit" role="button" tabindex="0" title="Arrastra el plumón para rayar la libreta" aria-label="Plumón Sharpie interactivo">
    <img 
      src="/assets/home/plumon.png" 
      alt="Plumón rojo interactivo" 
      class="sharpie-marker-img" 
      id="sharpieMarkerImg"
      draggable="false"
    />
  </div>

</div>

<style>
  .interactive-sharpie-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* 
    Canvas de dibujo interactivo:
    z-index: 1 para estar DEBAJO del contenido interactivo (botones z-index: 25, links, etc.)
    y con pointer-events: none en el canvas para que NO bloquee jamás ninguna interacción con la página.
  */
  .sharpie-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1; /* Debajo de los textos y botones */
    pointer-events: none; /* No bloquea clics en los enlaces/botones */
    mix-blend-mode: multiply;
  }

  /* 
    El plumón físico:
    Reemplaza la imagen estática en la esquina inferior derecha.
    Punto pivote / punta: lado izquierdo horizontal, centro vertical (0px 50%).
    En reposo: rotación fija original (-8deg) y tamaño exacto (440px).
    Hover: se levanta a -5deg.
    Al presionar/arrastrar: se inclina a -20deg (+-5deg) con su punta exactamente en el cursor.
  */
  .sharpie-marker-unit {
    position: relative;
    width: 440px;
    height: auto;
    cursor: grab;
    transform-origin: 0% 50%; /* Lado izquierdo horizontal, centro vertical */
    transform: rotate(-8deg);
    transition: filter 0.2s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    user-select: none;
    touch-action: none;
    will-change: transform;
    filter: drop-shadow(4px 8px 12px rgba(60, 40, 20, 0.18));
  }

  /* En hover: se levanta a -5deg */
  .sharpie-marker-unit:hover:not(.is-dragging) {
    transform: rotate(-5deg) translateY(-4px);
    filter: drop-shadow(6px 12px 18px rgba(60, 40, 20, 0.25));
  }

  /* Durante el arrastre activo */
  .sharpie-marker-unit.is-dragging {
    cursor: grabbing;
    z-index: 999;
    filter: drop-shadow(8px 16px 20px rgba(40, 20, 10, 0.28));
    transition: none !important;
  }

  /* Al soltar: transición suave de regreso al reposo sin saltos */
  .sharpie-marker-unit.is-returning {
    cursor: default;
    z-index: 999;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), filter 0.3s ease !important;
    filter: drop-shadow(4px 8px 12px rgba(60, 40, 20, 0.18));
  }

  .sharpie-marker-img {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .sharpie-marker-unit {
      width: 320px;
    }
  }
</style>

<script>
  interface StrokeSegment {
    x1: number;
    y1: number;
    x2: number;
    y2: number;
    color: string;
    width: number;
    timestamp: number;
  }

  function initSharpieInteractivePen() {
    const canvas = document.getElementById('sharpieCanvas') as HTMLCanvasElement;
    const marker = document.getElementById('sharpieMarker') as HTMLElement;
    if (!canvas || !marker) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const currentColor = '#EE2A22'; // Rojo oficial Amalia

    // Trazos que desaparecen a los 3s
    let strokeSegments: StrokeSegment[] = [];
    const FADE_LIFETIME_MS = 3000; // 3 segundos

    // Resize canvas nítido
    function resizeCanvas() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Estado del plumón
    let isDragging = false;
    let isReturning = false;
    let lastPoint: { x: number; y: number } | null = null;

    // Offset relativo al reposo durante el arrastre
    let currentDeltaX = 0;
    let currentDeltaY = 0;
    let targetDeltaX = 0;
    let targetDeltaY = 0;
    let currentAngle = -8;
    let targetAngle = -8;

    // Coordenadas absolutas de la punta (x: 0, y: 50%) en reposo dentro del viewport
    let restPivotX = 0;
    let restPivotY = 0;

    // Calcula la coordenada absoluta de la punta (0, 50%) en la posición de reposo
    function updateRestPivot() {
      const wrapper = document.getElementById('sharpieWrapper') || marker.parentElement;
      if (!wrapper) return;
      const wrapRect = wrapper.getBoundingClientRect();
      const markerH = marker.offsetHeight || 55;
      // En reposo, marker está en top: 0, left: 0 dentro del wrapper con rotate(-8deg) y transform-origin: 0% 50%.
      // Por tanto, el punto pivote (0, 50%) está EXACTAMENTE en (wrapRect.left, wrapRect.top + markerH / 2).
      restPivotX = wrapRect.left;
      restPivotY = wrapRect.top + (markerH / 2);
    }

    // Inicio de arrastre/dibujo al hacer clic sobre el plumón
    function onMarkerDown(e: MouseEvent | TouchEvent) {
      if (isReturning) return;
      e.preventDefault();

      const clientX = 'touches' in e && e.touches.length > 0 ? e.touches[0].clientX : (e as MouseEvent).clientX;
      const clientY = 'touches' in e && e.touches.length > 0 ? e.touches[0].clientY : (e as MouseEvent).clientY;

      updateRestPivot();

      isDragging = true;
      marker.classList.add('is-dragging');
      marker.classList.remove('is-returning');

      // El delta necesario para que la punta (pivote 0% 50%) viaje desde restPivot hasta el cursor:
      targetDeltaX = clientX - restPivotX;
      targetDeltaY = clientY - restPivotY;
      currentDeltaX = targetDeltaX;
      currentDeltaY = targetDeltaY;

      targetAngle = -20;
      currentAngle = -20;

      // Aplicar posición inmediatamente
      marker.style.transform = `translate3d(${currentDeltaX}px, ${currentDeltaY}px, 0) rotate(${currentAngle}deg)`;

      // El trazo empieza exactamente en la punta (clientX, clientY)
      lastPoint = { x: clientX, y: clientY };

      strokeSegments.push({
        x1: clientX,
        y1: clientY,
        x2: clientX + 0.1,
        y2: clientY + 0.1,
        color: currentColor,
        width: 6,
        timestamp: performance.now()
      });

      window.addEventListener('mousemove', onWindowMove);
      window.addEventListener('mouseup', onWindowUp);
      window.addEventListener('touchmove', onWindowMove, { passive: false });
      window.addEventListener('touchend', onWindowUp);
    }

    function onWindowMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      if ('touches' in e) e.preventDefault();

      const clientX = 'touches' in e && e.touches.length > 0 ? e.touches[0].clientX : (e as MouseEvent).clientX;
      const clientY = 'touches' in e && e.touches.length > 0 ? e.touches[0].clientY : (e as MouseEvent).clientY;

      targetDeltaX = clientX - restPivotX;
      targetDeltaY = clientY - restPivotY;

      // Inclinación dinámica de -20° +-5° según movimiento horizontal
      const dx = clientX - (restPivotX + currentDeltaX);
      const tiltVariation = Math.max(-5, Math.min(5, dx * 0.15));
      targetAngle = -20 + tiltVariation;
    }

    function onWindowUp() {
      if (!isDragging) return;
      isDragging = false;
      lastPoint = null;

      window.removeEventListener('mousemove', onWindowMove);
      window.removeEventListener('mouseup', onWindowUp);
      window.removeEventListener('touchmove', onWindowMove);
      window.removeEventListener('touchend', onWindowUp);

      // Regresar suavemente a su posición original de reposo (translate3d(0, 0, 0) rotate(-8deg))
      isReturning = true;
      marker.classList.remove('is-dragging');
      marker.classList.add('is-returning');

      // Animamos directamente hacia (0, 0) con su rotación de reposo original
      marker.style.transform = 'translate3d(0, 0, 0) rotate(-8deg)';

      setTimeout(() => {
        // Restaurar estado estático de reposo sin alterar el layout:
        marker.classList.remove('is-returning');
        marker.style.transform = '';
        isReturning = false;
      }, 520);
    }

    marker.addEventListener('mousedown', onMarkerDown);
    marker.addEventListener('touchstart', onMarkerDown, { passive: false });

    // Loop de renderizado continuo a 60fps
    function renderLoop() {
      const now = performance.now();

      // 1. Mover el plumón y sincronizar el punto de contacto de la punta
      if (isDragging) {
        currentDeltaX += (targetDeltaX - currentDeltaX) * 0.55;
        currentDeltaY += (targetDeltaY - currentDeltaY) * 0.55;
        currentAngle += (targetAngle - currentAngle) * 0.35;

        // Con transform-origin: 0% 50%, la punta en (0, 50%) se desplaza exactamente currentDeltaX/Y
        // desde su punto de reposo, y rota sin desplazarse!
        marker.style.transform = `translate3d(${currentDeltaX}px, ${currentDeltaY}px, 0) rotate(${currentAngle}deg)`;

        const actualTipX = restPivotX + currentDeltaX;
        const actualTipY = restPivotY + currentDeltaY;

        if (lastPoint) {
          const dist = Math.hypot(actualTipX - lastPoint.x, actualTipY - lastPoint.y);
          if (dist > 0.5) {
            strokeSegments.push({
              x1: lastPoint.x,
              y1: lastPoint.y,
              x2: actualTipX,
              y2: actualTipY,
              color: currentColor,
              width: 6,
              timestamp: now
            });
            lastPoint = { x: actualTipX, y: actualTipY };
          }
        } else {
          lastPoint = { x: actualTipX, y: actualTipY };
        }
      }

      // 2. Limpiar y dibujar trazos con desvanecimiento a los 3s
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

      let aliveCount = 0;
      for (let i = 0; i < strokeSegments.length; i++) {
        const seg = strokeSegments[i];
        const age = now - seg.timestamp;

        if (age < FADE_LIFETIME_MS) {
          const progress = age / FADE_LIFETIME_MS;
          const alpha = Math.max(0, 1 - progress);

          ctx.beginPath();
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.strokeStyle = seg.color;
          ctx.globalAlpha = alpha * 0.88;
          ctx.lineWidth = seg.width;
          ctx.moveTo(seg.x1, seg.y1);
          ctx.lineTo(seg.x2, seg.y2);
          ctx.stroke();

          strokeSegments[aliveCount] = seg;
          aliveCount++;
        }
      }
      strokeSegments.length = aliveCount;
      ctx.globalAlpha = 1.0;

      requestAnimationFrame(renderLoop);
    }
    requestAnimationFrame(renderLoop);
  }

  document.addEventListener('DOMContentLoaded', initSharpieInteractivePen);
  document.addEventListener('astro:page-load', initSharpieInteractivePen);
  document.addEventListener('astro:after-swap', initSharpieInteractivePen);
</script>
