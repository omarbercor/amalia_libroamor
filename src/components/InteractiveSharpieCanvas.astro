---
// InteractiveSharpieCanvas.astro
// Módulo interactivo de dibujo libre inspirado en codepen.io/bradarnett/pen/XyZKaG
// Código limpio, modular, ultraligero y rápido de cargar.
// Usa Canvas 2D con simulación de plumón Sharpie (física de inclinación, grosor variable y punta de plumón sin marcas).
---

<div class="interactive-sharpie-module" id="sharpieDrawingModule" aria-hidden="true">
  <!-- Canvas de dibujo interactivo -->
  <canvas id="sharpieCanvas" class="sharpie-canvas"></canvas>

  <!-- Puntero visual que simula el plumón tipo Sharpie siguiendo el cursor con inclinación dinámica -->
  <div id="sharpiePenFollower" class="sharpie-pen-follower" aria-hidden="true">
    <img 
      src="/assets/home/plumon.png" 
      alt="Plumón Sharpie interactivo" 
      class="sharpie-pen-img"
      id="sharpiePenImg"
    />
  </div>

  <!-- Controles flotantes limpios y elegantes tipo CodePen -->
  <div class="sharpie-controls" id="sharpieControls">
    <!-- Paleta de colores Amalia -->
    <ul class="sharpie-colours" id="sharpieColours" role="toolbar" aria-label="Colores de plumón">
      <li class="color-dot active" data-color="#EE2A22" style="background-color: #EE2A22;" title="Rojo Amalia"></li>
      <li class="color-dot" data-color="#1E1A18" style="background-color: #1E1A18;" title="Negro Tinta"></li>
      <li class="color-dot" data-color="#759BA9" style="background-color: #759BA9;" title="Azul Pastel"></li>
      <li class="color-dot" data-color="#77DD77" style="background-color: #77DD77;" title="Verde Suave"></li>
      <li class="color-dot" data-color="#FFD1DC" style="background-color: #FFD1DC;" title="Rosa Pastel"></li>
    </ul>

    <!-- Botón Limpiar / Clear -->
    <button type="button" class="sharpie-btn sharpie-refresh" id="sharpieClearBtn" title="Limpiar trazos">
      <span class="btn-text">LIMPIAR</span>
    </button>

    <!-- Botón Guardar / Save -->
    <button type="button" class="sharpie-btn sharpie-submit" id="sharpieSaveBtn" title="Guardar dibujo">
      <span class="btn-text">GUARDAR</span>
    </button>
  </div>
</div>

<style>
  .interactive-sharpie-module {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 40;
    overflow: hidden;
  }

  /* Canvas transparente que se mezcla con la textura del papel */
  .sharpie-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
    touch-action: none;
    mix-blend-mode: multiply;
    cursor: crosshair;
  }

  /* Plumón interactivo que sigue el mouse con rotación e inclinación */
  .sharpie-pen-follower {
    position: fixed;
    top: 0;
    left: 0;
    width: 240px;
    height: 32px;
    pointer-events: none;
    z-index: 50;
    opacity: 0;
    transform-origin: 10px 16px; /* La punta del plumón a la izquierda */
    transition: opacity 0.25s ease;
    will-change: transform;
    filter: drop-shadow(6px 12px 14px rgba(40, 20, 10, 0.22));
  }

  .sharpie-pen-follower.visible {
    opacity: 1;
  }

  .sharpie-pen-img {
    width: 100%;
    height: auto;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Barra de herramientas minimalista inspirada en el codepen */
  .sharpie-controls {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1.4rem;
    background: rgba(250, 246, 238, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(238, 42, 34, 0.25);
    border-radius: 30px;
    padding: 0.5rem 1.2rem;
    box-shadow: 0 8px 24px rgba(40, 25, 15, 0.08);
    pointer-events: auto;
    z-index: 60;
  }

  /* Selector de colores */
  .sharpie-colours {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 10px;
  }

  .color-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    border: 2px solid #FFFFFF;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  .color-dot:hover {
    transform: scale(1.25);
  }

  .color-dot.active {
    transform: scale(1.35);
    box-shadow: 0 0 0 2px var(--color-primary-red, #EE2A22), 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  /* Botones Clean / Save */
  .sharpie-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-primary-title, 'Amaliafont_altas', sans-serif);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: var(--color-primary-red, #EE2A22);
    padding: 0.25rem 0.6rem;
    border-radius: 14px;
    transition: all 0.2s ease;
    user-select: none;
  }

  .sharpie-btn:hover {
    background: rgba(238, 42, 34, 0.1);
    transform: scale(1.05);
  }

  .sharpie-btn:active {
    transform: scale(0.96);
  }

  @media (max-width: 768px) {
    .sharpie-pen-follower {
      display: none; /* En móvil se usa el dedo directamente */
    }

    .sharpie-controls {
      bottom: 16px;
      gap: 0.8rem;
      padding: 0.4rem 0.9rem;
    }

    .sharpie-btn {
      font-size: 0.75rem;
      padding: 0.2rem 0.4rem;
    }
  }
</style>

<script>
  function initSharpieModule() {
    const canvas = document.getElementById('sharpieCanvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const penFollower = document.getElementById('sharpiePenFollower') as HTMLElement;
    const colorDots = document.querySelectorAll('#sharpieColours .color-dot');
    const clearBtn = document.getElementById('sharpieClearBtn');
    const saveBtn = document.getElementById('sharpieSaveBtn');

    // Colores disponibles
    const colors = ['#EE2A22', '#1E1A18', '#759BA9', '#77DD77', '#FFD1DC'];
    let currentColor = colors[0];

    // Ajuste de tamaño full screen nítido con devicePixelRatio
    function resizeCanvas() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;
      ctx.scale(dpr, dpr);
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // Estado del plumón y dibujo
    let isDrawing = false;
    let lastPoint: { x: number; y: number } | null = null;
    let targetThickness = 5;
    let currentThickness = 5;
    const minThickness = 3.5;
    const maxThickness = 7.5;

    // Física e inclinación del plumón (Sharpie)
    let penX = window.innerWidth / 2;
    let penY = window.innerHeight / 2;
    let targetX = penX;
    let targetY = penY;
    let angle = -25; // Ángulo ergonómico de reposo tipo dibujo
    let targetAngle = -25;

    // Selector de color
    colorDots.forEach((dot, index) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        colorDots.forEach((d) => d.classList.remove('active'));
        dot.classList.add('active');
        currentColor = colors[index] || '#EE2A22';
      });
    });

    // Limpiar canvas
    clearBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    });

    // Guardar PNG
    saveBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = canvas.width;
      exportCanvas.height = canvas.height;
      const exportCtx = exportCanvas.getContext('2d');
      if (!exportCtx) return;

      // Fondo papel beige
      exportCtx.fillStyle = '#F7F1E5';
      exportCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
      exportCtx.drawImage(canvas, 0, 0);

      const link = document.createElement('a');
      link.download = 'amalia-dibujo-plumon.png';
      link.href = exportCanvas.toDataURL('image/png');
      link.click();
    });

    // Eventos de posición
    function getPointerPos(e: MouseEvent | TouchEvent) {
      const rect = canvas.getBoundingClientRect();
      if ('touches' in e && e.touches.length > 0) {
        return {
          x: e.touches[0].clientX - rect.left,
          y: e.touches[0].clientY - rect.top
        };
      } else if (e instanceof MouseEvent) {
        return {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top
        };
      }
      return { x: 0, y: 0 };
    }

    function onPointerDown(e: MouseEvent | TouchEvent) {
      const target = e.target as HTMLElement;
      if (target.closest('#sharpieControls') || target.closest('a') || target.closest('button')) {
        return;
      }

      isDrawing = true;
      targetThickness = maxThickness;
      const pt = getPointerPos(e);
      lastPoint = pt;
      targetX = pt.x;
      targetY = pt.y;

      // Punto inicial
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, currentThickness / 2, 0, Math.PI * 2);
      ctx.fillStyle = currentColor;
      ctx.globalAlpha = 0.9;
      ctx.fill();
    }

    function onPointerMove(e: MouseEvent | TouchEvent) {
      const pt = getPointerPos(e);
      targetX = pt.x;
      targetY = pt.y;

      if (penFollower) {
        penFollower.classList.add('visible');
      }

      if (!isDrawing || !lastPoint) {
        // Cálculo del ángulo sutil según hacia dónde se mueve el puntero
        if (lastPoint) {
          const dx = pt.x - lastPoint.x;
          const dy = pt.y - lastPoint.y;
          if (Math.abs(dx) > 1 || Math.abs(dy) > 1) {
            targetAngle = Math.atan2(dy, dx) * (180 / Math.PI);
          }
        }
        lastPoint = pt;
        return;
      }

      // Dibujo interpolado de alta fidelidad estilo tinta Sharpie
      const dist = Math.hypot(pt.x - lastPoint.x, pt.y - lastPoint.y);
      const angleRad = Math.atan2(pt.y - lastPoint.y, pt.x - lastPoint.x);
      targetAngle = angleRad * (180 / Math.PI);

      // Trazo continuo suave
      ctx.beginPath();
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = currentColor;
      ctx.globalAlpha = 0.88;
      ctx.lineWidth = currentThickness;
      ctx.moveTo(lastPoint.x, lastPoint.y);
      ctx.lineTo(pt.x, pt.y);
      ctx.stroke();

      lastPoint = pt;
    }

    function onPointerUp() {
      isDrawing = false;
      targetThickness = minThickness;
      lastPoint = null;
    }

    // Loop de animación fluido (60fps) para seguimiento e inercia del plumón tipo Sharpie
    function renderLoop() {
      // Inercia suave hacia el puntero
      penX += (targetX - penX) * 0.28;
      penY += (targetY - penY) * 0.28;
      angle += (targetAngle - angle) * 0.15;
      currentThickness += (targetThickness - currentThickness) * 0.2;

      if (penFollower) {
        // Si está dibujando, se comprime y rota ligeramente la punta contra el papel
        const pressScale = isDrawing ? 0.96 : 1;
        const liftY = isDrawing ? 0 : -6;
        penFollower.style.transform = `translate3d(${penX}px, ${penY + liftY}px, 0) rotate(${angle - 15}deg) scale(${pressScale})`;
      }

      requestAnimationFrame(renderLoop);
    }
    requestAnimationFrame(renderLoop);

    // Listeners
    canvas.addEventListener('mousedown', onPointerDown);
    window.addEventListener('mousemove', onPointerMove);
    window.addEventListener('mouseup', onPointerUp);
    canvas.addEventListener('mouseleave', () => {
      penFollower?.classList.remove('visible');
    });

    canvas.addEventListener('touchstart', onPointerDown, { passive: true });
    window.addEventListener('touchmove', onPointerMove, { passive: true });
    window.addEventListener('touchend', onPointerUp);
  }

  document.addEventListener('DOMContentLoaded', initSharpieModule);
  document.addEventListener('astro:page-load', initSharpieModule);
  document.addEventListener('astro:after-swap', initSharpieModule);
</script>
