    </g>

    <!-- SUBRAYADO 2: Bajo DE SU VIDA -->
    <g id="title-subrayado-2" class="title-sub-group">
      <path id="title-sub-2" class="title-stroke underline-stroke" d="M140.8,336.7s232.8-22.7,474.6-6.4" />
    </g>
  </svg>
</div>

<style>
  .title-svg-container {
    width: 100%;
    display: flex;
    justify-content: center;
    cursor: default;
  }

  .animated-title-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .title-stroke {
    fill: none;
    stroke: var(--color-primary-red, #ee2a22);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 10px;
    stroke-miterlimit: 10;
  }

  .underline-stroke {
    stroke-width: 11px;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

  gsap.registerPlugin(DrawSVGPlugin);

  function animateMainTitle() {
    const l1Strokes = document.querySelectorAll('#title-line-1 .title-stroke');
    const l2Strokes = document.querySelectorAll('#title-line-2 .title-stroke');
    const l3Strokes = document.querySelectorAll('#title-line-3 .title-stroke');
    const sub1 = document.getElementById('title-sub-1');
    const sub2 = document.getElementById('title-sub-2');

    const allStrokes = document.querySelectorAll('#mainTitleSvg .title-stroke');
    if (!allStrokes.length) return;

    // Inicializar todos los trazos en 0%
    gsap.set(allStrokes, { drawSVG: '0%' });

    const tl = gsap.timeline({
      delay: 0.25,
      defaults: { ease: 'power1.inOut' }
    });

    // 1. Trazo fluido de izquierda a derecha de la Línea 1: "UNO SIEMPRE"
    tl.to(l1Strokes, {
      drawSVG: '100%',
      duration: 0.35,
      stagger: 0.045
    })
    // 2. Línea 2: "CAMBIA AL AMOR"
    .to(l2Strokes, {
      drawSVG: '100%',
      duration: 0.32,
      stagger: 0.04
    }, '-=0.08')
    // 3. Subrayado 1 (Bajo CAMBIA AL AMOR)
    .to(sub1, {
      drawSVG: '100%',
      duration: 0.45,
      ease: 'power2.out'
    }, '-=0.05')
    // 4. Línea 3: "DE SU VIDA"
    .to(l3Strokes, {
      drawSVG: '100%',
      duration: 0.32,
      stagger: 0.045
    }, '-=0.1')
    // 5. Subrayado 2 (Bajo DE SU VIDA)
    .to(sub2, {
      drawSVG: '100%',
      duration: 0.4,
      ease: 'power2.out'
    }, '-=0.05');

    // 6. Animación de botones de acción:
    // Los textos se escriben desde que va apareciendo la caja contenedora de cada uno.
    // Entre el botón 1 y el botón 2 se solapan en tiempo por -0.6s.
    const actionBtns = document.querySelectorAll('.home-action-btn');
    const btn1Box = document.getElementById('btn1_container');
    const btn2Box = document.getElementById('btn2_container');
    const btn1Strokes = document.querySelectorAll('#btn1_text_group .btn-text-stroke');
    const btn2Strokes = document.querySelectorAll('#btn2_text_group .btn-text-stroke');

    if (actionBtns.length > 0) {
      gsap.set(actionBtns, { opacity: 1, y: 0 });
      if (btn1Box && btn2Box) {
        gsap.set([btn1Box, btn2Box], {
          scale: 0.6,
          opacity: 0,
          transformOrigin: 'center center'
        });
      }
      if (btn1Strokes.length) gsap.set(btn1Strokes, { drawSVG: '0%' });
      if (btn2Strokes.length) gsap.set(btn2Strokes, { drawSVG: '0%' });

      // Sub-timeline para Botón 1: Caja y texto arrancan prácticamente en simultáneo
      const btn1Tl = gsap.timeline();
      if (btn1Box) {
        btn1Tl.to(btn1Box, {
          scale: 1,
          opacity: 1,
          duration: 0.55,
          ease: 'back.out(1.7)'
        });
      }
      if (btn1Strokes.length) {
        btn1Tl.to(btn1Strokes, {
          drawSVG: '100%',
          duration: 0.28,
          stagger: 0.035,
          ease: 'power1.inOut'
        }, '<0.08'); // Se empieza a escribir desde que va apareciendo la caja
      }

      // Sub-timeline para Botón 2: Caja y texto arrancan prácticamente en simultáneo
      const btn2Tl = gsap.timeline();
      if (btn2Box) {
        btn2Tl.to(btn2Box, {
          scale: 1,
          opacity: 1,
          duration: 0.55,
          ease: 'back.out(1.7)'
        });
      }
      if (btn2Strokes.length) {
        btn2Tl.to(btn2Strokes, {
          drawSVG: '100%',
          duration: 0.28,
          stagger: 0.035,
          ease: 'power1.inOut'
        }, '<0.08'); // Se empieza a escribir desde que va apareciendo la caja
      }

      // Añadimos Botón 1 a la línea principal (con un pequeño respiro tras el título)
      tl.add(btn1Tl, '+=0.1');
      // Añadimos Botón 2 sobrepuesto en tiempo por -0.6s con respecto al anterior
      tl.add(btn2Tl, '-=0.6');

      // Notificar que el título y los botones ya terminaron de mostrarse
      tl.call(() => {
        window.dispatchEvent(new CustomEvent('intro-animation-completed'));
      });
    }
  }

  document.addEventListener('DOMContentLoaded', animateMainTitle);
  document.addEventListener('astro:page-load', animateMainTitle);
  document.addEventListener('astro:after-swap', animateMainTitle);
</script>
