      <path id="title-l2-14" class="title-stroke" d="M634.6,179.9c3.8-18.2,5.4-69.6,5.4-69.6-13.4,20.6-25.6,62.7-25.6,62.7l-2-.3-.6-51.9c-.2-19.5-7.8,8-7.8,8l-17,55.2" />
      <path id="title-l2-15" class="title-stroke" d="M681.4,111.3s-16,.6-21.6,31.1,9.7,31.6,9.7,31.6c0,0,12.4,3.8,19.3-28.2,5.7-26.2-5.7-34.8-9.9-35.4" />
