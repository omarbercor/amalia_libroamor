      <path id="title-l3-5" class="title-stroke" d="M340.2,258.5s-14.1-12.5-27.1-6.7c-2.9,1-12.7,7-11.1,14s6.6,11.7,19.4,12.8c16.8,1.4,15.5,7.6,15.2,9.3s-3.4,9.2-20.2,10.5c0,0-4.2-.3-5-1.1" />
      <path id="title-l3-6" class="title-stroke" d="M359.9,248.9s-7.3,43.1,7.8,46.2c10.1,2.1,16.4-13.7,24.7-51.8" />
      <path id="title-l3-7" class="title-stroke" d="M437.8,238.8s.4.9.4,1.2,3,43.8,7.3,50.3c0,0,3.1,20.2,10.6-5.4,5.9-20.3,12.2-42.5,12.6-43.3s3.4-7.8,3.4-7.8" />
      <path id="title-l3-8" class="title-stroke" d="M494.4,238.1v1.5c0,.7-7,47.6-7.1,48.7-.2,3.2,0,10.5,0,10.5" />
      <path id="title-l3-9" class="title-stroke" d="M520.1,237.9s-5.1,49.5-8.9,61c0,0,25.3,4.1,32.9-27.6,6.9-29.2-25.2-32.3-25.2-32.3" />
