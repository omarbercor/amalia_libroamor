---
// Rayones04Animated.astro - Decoración de rayones rojos SVG animada
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}

const { class: className = '', width = '155', height = '67' } = Astro.props;
---

<div class={`rayones-compra-wrapper ${className}`}>
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 155.37 67.32" 
    width={width}
    height={height}
    class="rayones-svg"
    aria-hidden="true"
  >
    <path 
      class="rayones-path" 
      d="M146,32.99s-22.62,7.94-18.11-9.53c4.51-17.47,34.91-15.11,21.26-3.53-13.65,11.58-39.31,19.33-37.68,4.17s20.72-27.38,22.79-6.35c2.07,21.03-30.1,25.47-37.25,24.64-7.14-.83-15.82-15.35,17.41-28.56,33.23-13.21-.03,27.19-26.77,31.77s-28.71-6.12-6.69-22.79c22.02-16.67,24.47-6.07,18.54,5.28-5.92,11.35-40.67,41.62-46.14,16.69-5.47-24.93,49.35-27.1,30.13-9.57-19.22,17.53-47.51,32.49-50.72,19.44s35.88-36.73,22.9-13.11-48.58,31.72-38.67,13.07,44.91-36.14,22.57-9.92c-22.33,26.22-45.18,19.78-30.56-3.28,14.62-23.06,37.83-21.01,31.77-13.45" 
      fill="none" 
      stroke="#EE2A22" 
      stroke-width="2.5" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    />
  </svg>
</div>

<style>
  .rayones-compra-wrapper {
    display: inline-block;
    line-height: 0;
    cursor: default;
  }

  .rayones-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .rayones-path {
    fill: none;
    stroke: #EE2A22;
    stroke-width: 2.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

  gsap.registerPlugin(DrawSVGPlugin);

  function initRayones() {
    const path = document.querySelector('.rayones-compra-wrapper .rayones-path');
    if (!path) return;

    gsap.set(path, { drawSVG: '0%' });
    gsap.to(path, {
      drawSVG: '100%',
      duration: 1.5,
      delay: 0.3,
      ease: 'power1.inOut'
    });
  }

  document.addEventListener('DOMContentLoaded', initRayones);
  document.addEventListener('astro:page-load', initRayones);
</script>
