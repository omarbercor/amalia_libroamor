---
// ScribbleDoodleAnimated.astro - Garabato/rayón animado con GSAP DrawSVGPlugin
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
}

const { class: className = '', width = '180', height = '55' } = Astro.props;
---

<div class={`scribble-doodle-container ${className}`}>
  <svg 
    id="scribbleDoodleSvg"
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 234.59 72.05"
    width={width}
    height={height}
    class="scribble-svg"
    aria-label="Garabato dibujado a mano"
  >
    <path 
      id="scribble-path"
      class="scribble-stroke"
      d="M40.73,17.11l-24,49.48L61.17,12.07l-22.22,50.96s-5.33,16.3,10.67-7.11c16-23.41,23.11-36.15,23.11-36.15,0,0-2.07,13.63-25.19,48,0,0,28.97-48.32-4.74-40.89,0,0-66.96,19.26-26.07,16.59,40.89-2.67,89.48-6.22,89.48-6.22,0,0,67.85-3.85,31.11,8.59,0,0-81.19,8-88.59,16.59,0,0,59.56-26.67,74.07-32.59,14.52-5.93,50.96-20.74,23.41.3-27.56,21.04-40.3,31.11-40.3,31.11,0,0-20.74,16.89,25.84-39.88,0,0,36.98-43.68,10.61,5.51,0,0-43.85,69.33,10.37,6.22,0,0,40-45.59,13.63-2.96,0,0-35.56,59.04-.59,13.33,0,0,44.15-50.07,33.19-21.93,0,0-32,59.56.3,16,0,0,16.59-24,26.67-16.59s3.26,24.3-2.07,28.74"
    />
  </svg>
</div>

<style>
  .scribble-doodle-container {
    display: inline-block;
    line-height: 0;
    cursor: default;
  }

  .scribble-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .scribble-stroke {
    fill: none;
    stroke: var(--color-primary-red, #ee2a22);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 7px;
    stroke-miterlimit: 10;
  }
</style>

<script>
  // El garabato derecho permanece visible de forma natural
</script>
