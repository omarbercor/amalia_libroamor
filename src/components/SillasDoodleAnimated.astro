---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
  color?: string;
}

const { class: className = '', width = '140', height = '138', color = '#EE2A22' } = Astro.props;
---

<div class={`sillas-doodle-container ${className}`}>
  <svg 
    id="sillasDoodleSvg"
    xmlns="http://www.w3.org/2000/svg" 
    viewBox="0 0 144 142"
    width={width}
    height={height}
    class="sillas-svg"
    aria-label="Doodle sillas TU + YO dibujadas a mano"
  >
    <!-- Letras superiores T U + Y O -->
    <g class="sillas-letters-group" stroke={color} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <!-- T -->
      <line class="sillas-draw-stroke letter-stroke" x1="7.15" y1="23.71" x2="21.67" y2="19.86"/>
      <path class="sillas-draw-stroke letter-stroke" d="M17.07,35.71v-9.63l-1.24-4.67"/>
      <!-- U -->
      <path class="sillas-draw-stroke letter-stroke" d="M25.52,21.41s2.07,11.49,5.78,7.93c0,0,2.81-1.19,1.63-10.81"/>
      <!-- + -->
      <line class="sillas-draw-stroke letter-stroke" x1="58.11" y1="10.08" x2="60.33" y2="30.82"/>
      <line class="sillas-draw-stroke letter-stroke" x1="50.7" y1="23.71" x2="66.56" y2="20.45"/>
      <!-- Y -->
      <line class="sillas-draw-stroke letter-stroke" x1="79.89" y1="8.9" x2="92.33" y2="18.53"/>
      <path class="sillas-draw-stroke letter-stroke" d="M95.44,6.38c-.74,0-3.7.59-3.7.59l-3.56,23.85"/>
      <!-- O -->
      <path class="sillas-draw-stroke letter-stroke" d="M107.44,6.38s-8.44-1.04-8.15,7.33,6.22,8.67,9.04,6.74,5.63-16.3-2.81-14.96"/>
    </g>

    <!-- Silla Izquierda -->
    <g class="silla-left-group" stroke={color} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <!-- Pata / Respaldo principal -->
      <path class="sillas-draw-stroke chair-stroke" d="M8.56,47.04s2.89,32,3.11,34.22-1.33,18,0,20.89,4,31.33,4,31.33"/>
      <!-- Respaldo derecho -->
      <path class="sillas-draw-stroke chair-stroke" d="M39.44,43.04s3.33,20.89,3.33,24.44v15.33"/>
      <!-- Travesaño respaldo 1 -->
      <path class="sillas-draw-stroke chair-stroke" d="M38.33,52.38s-10.22,2.22-12.44,2.22H9.24"/>
      <!-- Travesaño respaldo 2 -->
      <path class="sillas-draw-stroke chair-stroke" d="M12.11,68.38s7.11,1.78,8.89,0,8.89-3.11,10.22-3.33,9.89-2.11,9.89-2.11"/>
      <!-- Asiento -->
      <path class="sillas-draw-stroke chair-stroke seat-stroke" d="M13,89.27s15.11,6.44,16.67,8.89,11.44,11.11,11.44,11.11c0,0,10.33-4,13.67-4s4.44-1.56,4.44-1.56l2.67-1.56s-12.89-21.11-14.44-21.33-27.56,5.56-29.33,6.89"/>
      <!-- Patas inferiores -->
      <path class="sillas-draw-stroke chair-stroke" d="M41.11,136.6s-1.44-13.11-1.67-13.78-1.11-13.56-1.11-13.56"/>
      <path class="sillas-draw-stroke chair-stroke" d="M66.11,133.49s-.89-11.56-.89-13.11-3.33-15.56-3.33-15.56"/>
      <polyline class="sillas-draw-stroke chair-stroke" points="52.11 122.93 52.11 114.6 50.33 107.71"/>
    </g>

    <!-- Silla Derecha -->
    <g class="silla-right-group" stroke={color} stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <!-- Respaldo derecho y postes -->
      <path class="sillas-draw-stroke chair-stroke" d="M82.78,39.27s4.89,16.89,5.11,18.89,2,16,2,16v45"/>
      <polyline class="sillas-draw-stroke chair-stroke" points="117.24 36.6 119.13 47.04 119.13 75.49"/>
      <polyline class="sillas-draw-stroke chair-stroke" points="85.67 48.15 100.33 47.04 117.22 43.04"/>
      <polyline class="sillas-draw-stroke chair-stroke" points="117.22 58.15 98.33 62.93 88.78 62.93"/>
      <!-- Asiento derecho -->
      <path class="sillas-draw-stroke chair-stroke seat-stroke" d="M89.89,80.82s29.33-3.99,30-5.33l11.33,14.78,5.78,7s-19.78,4.67-23.56,7.56l-14.22-14.67-9.33-7.33"/>
      <!-- Patas inferiores derechas -->
      <path class="sillas-draw-stroke chair-stroke" d="M117.22,129.49c.22-.89-2.22-13.11-2.22-13.11l-1.56-11.56"/>
      <path class="sillas-draw-stroke chair-stroke" d="M141,122.93s-2.44-23.22-4-23.22"/>
      <line class="sillas-draw-stroke chair-stroke" x1="129.89" y1="115.32" x2="129.89" y2="100.6"/>
    </g>
  </svg>
</div>

<style>
  .sillas-doodle-container {
    display: inline-block;
    line-height: 0;
    cursor: default;
  }

  .sillas-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sillas-draw-stroke {
    transform-origin: center;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

  gsap.registerPlugin(DrawSVGPlugin);

  function initSillasAnimation() {
    const strokes = document.querySelectorAll('#sillasDoodleSvg .sillas-draw-stroke');
    if (!strokes || strokes.length === 0) return;

    gsap.set(strokes, { drawSVG: '0%' });

    const tl = gsap.timeline({
      delay: 0.3,
      defaults: { ease: 'power1.inOut' }
    });

    const letters = document.querySelectorAll('#sillasDoodleSvg .letter-stroke');
    const chairStrokes = document.querySelectorAll('#sillasDoodleSvg .chair-stroke');

    tl.to(letters, {
      drawSVG: '100%',
      duration: 0.8,
      stagger: 0.08,
    })
    .to(chairStrokes, {
      drawSVG: '100%',
      duration: 1.4,
      stagger: 0.06,
    }, '-=0.3');
  }

  document.addEventListener('DOMContentLoaded', initSillasAnimation);
  document.addEventListener('astro:page-load', initSillasAnimation);
</script>
