---
// StoryCard.astro - Tarjeta de testimonio con marco imperfecto y tipografías consistentes
interface Props {
  categoria: string;
  texto: string;
  firma: string;
  index?: number;
  tipo?: string;
}

const { categoria, texto, firma, index = 0, tipo = "otro-amor" } = Astro.props;

// Leves variaciones orgánicas de rotación y border-radius según el index
const rotations = [-0.6, 0.4, -0.3, 0.5, -0.5, 0.3];
const currentRotation = rotations[index % rotations.length];
---

<article 
  class="story-note-card" 
  data-category={categoria.toLowerCase()}
  data-type={tipo.toLowerCase()}
  style={`--card-rot: ${currentRotation}deg;`}
>
  <!-- Borde dibujado a mano con SVG para efecto auténtico de libreta de Amalia -->
  <svg class="card-border-svg" viewBox="0 0 320 220" preserveAspectRatio="none" aria-hidden="true">
    <path 
      d="M8,12 C80,7 240,6 312,10 C315,60 316,160 311,210 C240,214 80,213 9,209 C6,160 5,60 8,12 Z" 
      fill="none" 
      stroke="#EE2A22" 
      stroke-width="2.5" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    />
  </svg>

  <div class="card-content">
    <span class="card-category">{categoria}</span>
    <p class="card-body-text">{texto}</p>
    <span class="card-signature">{firma}</span>
  </div>
</article>

<style>
  .story-note-card {
    position: relative;
    padding: 1.8rem 1.6rem;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: transparent;
    transform: rotate(var(--card-rot, 0deg));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }

  .card-border-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .story-note-card:hover {
    transform: translateY(-4px) rotate(0deg) scale(1.015);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 0.9rem;
    position: relative;
    z-index: 2;
  }

  .card-category {
    font-family: var(--font-regular, 'Open Sans', sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main, #1E1A18);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-body-text {
    font-family: var(--font-regular, 'Open Sans', sans-serif);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-text-main, #1E1A18);
    flex-grow: 1;
  }

  .card-signature {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 1.15rem;
    color: var(--color-marker-red, #EE2A22);
    font-weight: 400;
  }
</style>
