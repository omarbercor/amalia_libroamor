---
// StoryCard.astro - Tarjeta de testimonio con marcos irregulares auténticos dibujados a mano
interface Props {
  categoria: string;
  texto: string;
  firma: string;
  index?: number;
  tipo?: string;
  id?: number | string;
  slug?: string;
}

const { categoria, texto, firma, index = 0, tipo = "otro-amor", id, slug } = Astro.props;
const storyId = id || `post${index + 1}`;

// Colección de SVGs de marcos irregulares creados para los testimonios
const frameSvgs = [
  "/assets/feed_page/frames 130.svg",
  "/assets/feed_page/frames 131.svg",
  "/assets/feed_page/frames 132.svg",
  "/assets/feed_page/frames 133.svg",
  "/assets/feed_page/frames 134.svg",
  "/assets/feed_page/frames 135.svg",
  "/assets/feed_page/frames 165.svg",
  "/assets/feed_page/frames 166.svg",
  "/assets/feed_page/frames 167.svg",
];

const currentFrame = frameSvgs[index % frameSvgs.length];

// Leves variaciones orgánicas de rotación según el index
const rotations = [-0.6, 0.4, -0.3, 0.5, -0.5, 0.3];
const currentRotation = rotations[index % rotations.length];
---

<article 
  class="story-note-card" 
  data-category={categoria.toLowerCase()}
  data-type={tipo.toLowerCase()}
  data-story-id={String(storyId)}
  data-story-slug={slug || ''}
  data-full-text={texto}
  data-full-category={categoria}
  data-full-signature={firma}
  tabindex="0"
  role="button"
  aria-label={`Historia de ${categoria}: ${firma}. Haz clic para leer completa`}
  style={`--card-rot: ${currentRotation}deg;`}
>
  <!-- Marco irregular dibujado a mano original de Amalia -->
  <img 
    src={currentFrame} 
    alt="" 
    class="card-frame-svg-bg" 
    aria-hidden="true" 
    loading="lazy"
  />

  <div class="card-content">
    <div class="card-header-row">
      <span class="card-category">{categoria}</span>
    </div>
    <p class="card-body-text">{texto}</p>
    <div class="card-footer-row">
      <span class="card-signature">{firma}</span>
    </div>
  </div>
</article>

<style is:global>
  .story-note-card {
    position: relative;
    padding: 2.2rem 2.2rem 2rem 2.2rem;
    min-height: 230px;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: transparent;
    cursor: pointer;
    transform: rotate(var(--card-rot, 0deg));
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
    user-select: none;
  }

  .card-frame-svg-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    object-fit: fill;
  }

  .story-note-card:hover {
    transform: translateY(-4px) rotate(0deg) scale(1.015);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }

  .card-category {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-main, #1E1A18);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.2;
    padding: 0 0.2rem;
  }

  .card-body-text {
    font-family: var(--font-regular, 'Open Sans', sans-serif);
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--color-text-main, #1E1A18);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding: 0 0.2rem;
  }

  .card-footer-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.2rem;
    padding: 0 0.2rem;
  }

  .card-signature {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 1.12rem;
    color: var(--color-marker-red, #EE2A22);
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
    min-width: 0;
  }
</style>
