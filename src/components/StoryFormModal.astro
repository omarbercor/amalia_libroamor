---
// StoryFormModal.astro - Formulario de envío de historias con estética de hoja de libreta rasgada
---

<div class="torn-paper-card" id="tornPaperCard">
  <!-- Borde rasgado realista superior y laterales -->
  <div class="torn-edge-top"></div>
  
  <div class="torn-paper-inner">
    <div class="torn-paper-header">
      <span class="prompt-text">Sube tu historia</span>
      
      <!-- Sello Doodle Corazón "SÍ" -->
      <div class="stamp-heart-si" aria-hidden="true">
        <svg viewBox="0 0 65 65" class="stamp-svg">
          <path d="M32 55C18 44 8 33 8 20C8 11 15 6 23 6C29 6 32 10 32 10C32 10 35 6 41 6C50 6 56 11 56 20C56 33 46 44 32 55Z" stroke="#E02826" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="26" y="32" font-family="var(--font-marker)" font-size="18" fill="#E02826" font-weight="bold">SÍ</text>
        </svg>
      </div>
    </div>

    <!-- Área de escritura / disparador de modal -->
    <div class="story-preview-box" id="storyPreviewTrigger">
      <p class="story-placeholder-prompt">Escribe aquí lo que este libro te provocó... ese recuerdo que aún guardas a las 3 a.m.</p>
    </div>

    <button type="button" class="btn-marker-red btn-submit-story" id="openStoryModalBtn">
      ENVIAR HISTORIA
    </button>
  </div>
</div>

<!-- Modal Dialog de Envío Completo -->
<dialog class="story-modal-dialog" id="storyModalDialog">
  <div class="modal-torn-sheet">
    <button class="modal-close-btn" id="closeStoryModalBtn" aria-label="Cerrar modal">✕</button>

    <h2 class="modal-title">Cuéntanos tu historia</h2>
    <p class="modal-subtitle">Diez años de gente escribiéndome a las 3 a.m. Ahora hay un lugar para eso.</p>

    <form id="submitStoryForm" class="notebook-story-form">
      <div class="form-group">
        <label for="storyCategory">¿De qué trata tu historia?</label>
        <select id="storyCategory" name="categoria" required class="notebook-select">
          <option value="DUELO">Duelo</option>
          <option value="MUDANZAS">Mudanzas</option>
          <option value="AMISTAD">Amistad</option>
          <option value="DESAMOR">Desamor</option>
          <option value="CRECIMIENTO">Crecimiento personal</option>
        </select>
      </div>

      <div class="form-group">
        <label for="storyContent">Tu historia o recuerdo:</label>
        <textarea 
          id="storyContent" 
          name="historia" 
          rows="5" 
          required 
          placeholder="Escribe con libertad, como si fuera una página arrancada de tu diario..."
          class="notebook-textarea"
          maxlength="450"
        ></textarea>
        <span class="char-count" id="charCount">0 / 450</span>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="storyAuthor">Tu nombre o apodo:</label>
          <input type="text" id="storyAuthor" name="autor" required placeholder="Ej. Vale" class="notebook-input" />
        </div>
        <div class="form-group">
          <label for="storyAge">Edad (opcional):</label>
          <input type="text" id="storyAge" name="edad" placeholder="Ej. 34" class="notebook-input" />
        </div>
        <div class="form-group">
          <label for="storyCity">Ciudad:</label>
          <input type="text" id="storyCity" name="ciudad" required placeholder="Ej. Medellín" class="notebook-input" />
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-marker-red" id="submitFormBtn">
          ENVIAR MI HISTORIA
        </button>
      </div>

      <div class="form-status" id="formStatusMsg" aria-live="polite"></div>
    </form>
  </div>
</dialog>

<style>
  /* Tarjeta de papel rasgado en la página */
  .torn-paper-card {
    background-color: #FAF6ED;
    border-radius: 4px;
    box-shadow: 0 10px 25px rgba(80, 60, 40, 0.12), 0 2px 6px rgba(80, 60, 40, 0.08);
    position: relative;
    max-width: 420px;
    width: 100%;
    margin: 0 auto;
    transform: rotate(1.2deg);
    transition: transform 0.3s ease;
    border: 1px solid rgba(210, 195, 175, 0.5);
  }

  .torn-paper-card:hover {
    transform: rotate(0deg) scale(1.02);
  }

  /* Borde rasgado irregular */
  .torn-paper-card::before {
    content: "";
    position: absolute;
    top: -8px;
    left: 0;
    width: 100%;
    height: 12px;
    background: radial-gradient(circle at 10px 10px, transparent 8px, #FAF6ED 9px);
    background-size: 16px 16px;
    background-position: -8px -8px;
  }

  .torn-paper-inner {
    padding: 2.2rem 2rem 1.8rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .torn-paper-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .prompt-text {
    font-family: var(--font-notes);
    font-size: 1.35rem;
    color: var(--color-ink-black);
    font-weight: 500;
  }

  .stamp-heart-si {
    width: 55px;
    height: 55px;
    transform: rotate(8deg);
  }

  .stamp-svg {
    width: 100%;
    height: 100%;
  }

  .story-preview-box {
    background: rgba(240, 233, 220, 0.5);
    border: 1.5px dashed rgba(190, 170, 150, 0.6);
    border-radius: 8px;
    padding: 1.8rem 1.2rem;
    cursor: pointer;
    min-height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: all 0.2s ease;
  }

  .story-preview-box:hover {
    background: rgba(240, 233, 220, 0.8);
    border-color: var(--color-marker-red);
  }

  .story-placeholder-prompt {
    font-family: var(--font-notes);
    font-size: 1.15rem;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .btn-submit-story {
    width: 100%;
    margin-top: 0.5rem;
  }

  /* Modal de Envío */
  .story-modal-dialog {
    border: none;
    border-radius: 12px;
    padding: 0;
    background: transparent;
    max-width: 650px;
    width: 90vw;
    margin: auto;
    box-shadow: 0 25px 60px rgba(40, 25, 15, 0.35);
  }

  .story-modal-dialog::backdrop {
    background: rgba(30, 20, 15, 0.65);
    backdrop-filter: blur(4px);
  }

  .modal-torn-sheet {
    background-color: var(--color-paper-light);
    padding: 2.5rem 2.2rem;
    border-radius: 8px;
    position: relative;
    border: 2px solid var(--color-paper-dark);
  }

  .modal-close-btn {
    position: absolute;
    top: 1.2rem;
    right: 1.5rem;
    font-size: 1.6rem;
    color: var(--color-ink-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .modal-close-btn:hover {
    color: var(--color-marker-red);
    transform: rotate(90deg);
  }

  .modal-title {
    font-family: var(--font-marker);
    font-size: 2rem;
    color: var(--color-marker-red);
    margin-bottom: 0.2rem;
  }

  .modal-subtitle {
    font-family: var(--font-notes);
    font-size: 1.15rem;
    color: var(--color-ink-muted);
    margin-bottom: 1.5rem;
  }

  .notebook-story-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .form-group label {
    font-family: var(--font-notes);
    font-size: 1.1rem;
    font-weight: bold;
    color: var(--color-ink-black);
  }

  .notebook-input,
  .notebook-select,
  .notebook-textarea {
    font-family: var(--font-notes);
    font-size: 1.15rem;
    padding: 0.75rem 1rem;
    border: 1.5px solid #d4c8b6;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: var(--color-ink-black);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .notebook-textarea {
    resize: vertical;
    line-height: 1.5;
    background-image: linear-gradient(transparent, transparent 29px, #e8dfcf 30px);
    background-size: 100% 30px;
  }

  .notebook-input:focus,
  .notebook-select:focus,
  .notebook-textarea:focus {
    border-color: var(--color-marker-red);
    box-shadow: 0 0 0 3px rgba(224, 40, 38, 0.15);
  }

  .form-row {
    display: grid;
    grid-template-columns: 2fr 1fr 2fr;
    gap: 0.8rem;
  }

  .char-count {
    align-self: flex-end;
    font-size: 0.85rem;
    color: var(--color-ink-faint);
  }

  .form-actions {
    margin-top: 0.5rem;
    display: flex;
    justify-content: center;
  }

  .form-status {
    text-align: center;
    font-family: var(--font-handwriting);
    font-size: 1.3rem;
    color: var(--color-marker-red);
    min-height: 1.5rem;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('storyModalDialog') as HTMLDialogElement;
    const openBtn = document.getElementById('openStoryModalBtn');
    const previewTrigger = document.getElementById('storyPreviewTrigger');
    const closeBtn = document.getElementById('closeStoryModalBtn');
    const form = document.getElementById('submitStoryForm') as HTMLFormElement;
    const statusMsg = document.getElementById('formStatusMsg');
    const textarea = document.getElementById('storyContent') as HTMLTextAreaElement;
    const charCount = document.getElementById('charCount');

    const openModal = () => {
      dialog?.showModal();
    };

    const closeModal = () => {
      dialog?.close();
    };

    openBtn?.addEventListener('click', openModal);
    previewTrigger?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        closeModal();
      }
    });

    textarea?.addEventListener('input', () => {
      if (charCount) {
        charCount.textContent = `${textarea.value.length} / 450`;
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!statusMsg) return;

      statusMsg.textContent = 'Guardando tu pedacito de historia... ✨';
      
      setTimeout(() => {
        statusMsg.textContent = '¡Historia recibida con amor! Pasará al muro una vez moderada.';
        form.reset();
        if (charCount) charCount.textContent = '0 / 450';
        setTimeout(() => {
          closeModal();
          statusMsg.textContent = '';
        }, 2500);
      }, 800);
    });
  });
</script>
