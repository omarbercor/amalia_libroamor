---
import '../styles/global.css';
import ToastNotification from '../components/ToastNotification.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Uno siempre cambia al amor de su vida — 10 Años | Amalia Andrade",
  description = "Edición conmemorativa de los 10 años de 'Uno siempre cambia al amor de su vida (por otro amor o por otra vida)' de Amalia Andrade."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EE2A22" />

    <!-- Google Fonts: Open Sans (textos regulares) y Mynerve (títulos secundarios) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link 
      href="https://fonts.googleapis.com/css2?family=Mynerve&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body>
    <slot />
    <ToastNotification />
  </body>
</html>
