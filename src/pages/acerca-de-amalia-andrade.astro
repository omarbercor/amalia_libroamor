---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ButtonOpcionesCompra from '../components/ButtonOpcionesCompra.astro';
---

<Layout 
  title="Sobre Amalia Andrade | Uno siempre cambia al amor de su vida (edición 10 años)"
  description="Conoce más sobre Amalia Andrade, autora e ilustradora de Uno siempre cambia al amor de su vida (por otro amor o por otra vida)."
>
  <div class="acerca-page">
    <!-- Header oficial con flecha de regreso al Home -->
    <Header showBack={true} backUrl="/" />

    <main class="acerca-main">
      <!-- SECCIÓN SOBRE AMALIA -->
      <section class="sobre-amalia-section" id="sobre-amalia">
        <!-- Título SOBRE AMALIA animado en rojo con subrayado dinámico DrawSVG -->
        <div class="sobre-amalia-header">
          <div class="sobre-amalia-title-wrapper">
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              viewBox="0 0 460 210" 
              class="sobre-amalia-title-svg" 
              aria-label="Sobre Amalia"
            >
              <!-- Texto con Amaliafont_altas en color rojo -->
              <g class="sobre-amalia-title-texts">
                <text class="sobre-amalia-title-line" x="230" y="75" text-anchor="middle">
                  SOBRE
                </text>
                <text class="sobre-amalia-title-line" x="230" y="155" text-anchor="middle">
                  AMALIA
                </text>
              </g>

              <!-- Trazo de subrayado rojo con efecto plumón irregular -->
              <g class="sobre-amalia-underline-group">
                <path 
                  id="sobreAmaliaUnderline" 
                  class="sobre-amalia-underline-path" 
                  d="M 65,178 Q 230,168 395,182" 
                  fill="none" 
                  stroke="#EE2A22" 
                  stroke-width="7.5" 
                  stroke-linecap="round" 
                  stroke-linejoin="round"
                />
              </g>
            </svg>
          </div>
        </div>

        <div class="sobre-amalia-grid">
          <!-- Columna Izquierda: Polaroid de Amalia con cinta roja adhesiva (polaroid.png) -->
          <div class="polaroid-amalia-wrapper">
            <img 
              src="/assets/acerca/polaroid.png?v=3" 
              alt="Polaroid de Amalia Andrade fijada con cinta adhesiva roja y doodle" 
              class="polaroid-amalia-img"
              width="390"
              height="500"
              loading="eager"
            />
          </div>

          <!-- Columna Derecha: Biografía oficial de Amalia -->
          <div class="sobre-amalia-text-wrapper">
            <p class="amalia-bio-text">
              Nació en Cali, Colombia, en 1985. Es acuario. Estudió literatura en la Pontificia Universidad Javeriana de Bogotá. Dibuja y escribe desde que pudo hacerlo. Periodista, ilustradora, adivina, actriz a ratos. Su obra y sus libros son un fenómeno viral en redes sociales, ha vendido más de un millón de ejemplares, además de que se han traducido a seis idiomas. Ama correr. Dice chistes porque está convencida de que el humor es terapéutico. Su libro favorito de todos los tiempos es Mujercitas, de Louisa May Alcott. Vive en Bogotá con Río y Carmen, sus dos gatos.
            </p>
          </div>
        </div>

        <!-- Botón Ver Opciones de Compra -->
        <div class="acerca-cta-wrapper">
          <ButtonOpcionesCompra href="/comprar-libro" />
        </div>
      </section>
    </main>

    <!-- Footer oficial -->
    <Footer />
  </div>
</Layout>

<style>
  .acerca-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.5rem 3rem 1.8rem 3rem;
    overflow-x: hidden;
  }

  .acerca-main {
    flex: 1;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    padding: 1.5rem 0 3.5rem 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* Sección Sobre Amalia */
  .sobre-amalia-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1rem;
  }

  .sobre-amalia-header {
    text-align: center;
    margin-bottom: 2.2rem;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .sobre-amalia-title-wrapper {
    width: 100%;
    max-width: 420px;
    display: flex;
    justify-content: center;
  }

  .sobre-amalia-title-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .sobre-amalia-title-line {
    fill: var(--color-marker-red, #EE2A22);
    font-family: 'Amaliafont_altas-Regular', 'Amaliafont_altas', sans-serif;
    font-size: 68px;
    font-weight: normal;
    letter-spacing: 0.03em;
  }

  .sobre-amalia-underline-path {
    stroke: var(--color-marker-red, #EE2A22);
  }

  .sobre-amalia-grid {
    display: grid;
    grid-template-columns: 1.05fr 1.35fr;
    gap: 4.5rem;
    align-items: center;
    width: 100%;
    max-width: 950px;
    margin-bottom: 3.8rem;
  }

  .polaroid-amalia-wrapper {
    display: flex;
    justify-content: center;
  }

  .polaroid-amalia-img {
    max-width: 380px;
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 12px 24px rgba(60, 45, 30, 0.12));
    transition: transform 0.3s ease;
  }

  .polaroid-amalia-img:hover {
    transform: rotate(-1deg) scale(1.02);
  }

  .sobre-amalia-text-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.8rem;
  }

  .amalia-bio-text {
    font-family: var(--font-regular, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-ink-black, #1E1A18);
    margin: 0;
  }

  .acerca-cta-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: 2rem;
  }

  /* Responsive / Mobile */
  @media (max-width: 860px) {
    .acerca-page {
      padding: 1.2rem 1.4rem 1.4rem 1.4rem;
    }

    .acerca-main {
      padding: 1rem 0 2rem 0;
    }

    .sobre-amalia-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .sobre-amalia-text-wrapper {
      align-items: center;
    }

    .amalia-bio-text {
      font-size: 1.05rem;
      line-height: 1.68;
      max-width: 92%;
    }

    .polaroid-amalia-img {
      max-width: 290px;
    }

    .sobre-amalia-title-wrapper {
      max-width: 320px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';

  gsap.registerPlugin(DrawSVGPlugin);

  function initSobreAmaliaTitle() {
    const underline = document.getElementById('sobreAmaliaUnderline');
    if (!underline) return;

    gsap.set(underline, { drawSVG: '0%' });
    gsap.to(underline, {
      drawSVG: '100%',
      duration: 1.2,
      delay: 0.25,
      ease: 'power2.out'
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSobreAmaliaTitle);
  } else {
    initSobreAmaliaTitle();
  }
  document.addEventListener('astro:page-load', initSobreAmaliaTitle);
</script>
