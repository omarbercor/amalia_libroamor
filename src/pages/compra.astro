---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import countries from '../data/countries.json';

const col1 = countries.filter(c => ['ar', 'ec', 'pe', 'us'].includes(c.id));
const col2 = countries.filter(c => ['br', 'es', 'pt', 've'].includes(c.id));
const col3 = countries.filter(c => ['co', 'mx', 'uy'].includes(c.id));
---

<Layout 
  title="Opciones de Compra Internacional — 10 Años | Amalia Andrade"
  description="Consigue la edición especial de los 10 años de 'Uno siempre cambia al amor de su vida' en tu país."
>
  <div class="compra-page">
    <Header showBack={true} />

    <main class="compra-main">
      <div class="compra-header-block">
        <h1 class="compra-subtitle">
          Activa el super poder<br />
          de compra
        </h1>
      </div>

      <!-- Doodles Oficiales de la Referencia 3-Compra-Desk.jpg -->
      <div class="doodle-chairs-tu-yo" aria-hidden="true">
        <img 
          src="/assets/compra/doodle-sillas-tu-yo.png" 
          alt="Doodle sillas TU + YO" 
          class="doodle-img"
          width="150"
          height="130"
        />
      </div>

      <div class="doodle-heart-compra" aria-hidden="true">
        <img 
          src="/assets/compra/doodle-corazon.png" 
          alt="Doodle corazón" 
          class="doodle-img"
          width="120"
          height="110"
        />
      </div>

      <div class="doodle-spiral-compra" aria-hidden="true">
        <img 
          src="/assets/compra/doodle-espiral.png" 
          alt="Doodle espiral" 
          class="doodle-img"
          width="130"
          height="100"
        />
      </div>

      <div class="doodle-envelope-compra" aria-hidden="true">
        <img 
          src="/assets/compra/doodle-sobre-corazon.png" 
          alt="Doodle sobre con corazón" 
          class="doodle-img"
          width="130"
          height="100"
        />
      </div>

      <div class="doodle-scratch-compra" aria-hidden="true">
        <img 
          src="/assets/compra/doodle-scratch.png" 
          alt="Doodle garabato" 
          class="doodle-img"
          width="130"
          height="80"
        />
      </div>

      <!-- 3 Columnas de Países en Tipografía Oficial Amalia Altas -->
      <div class="countries-grid">
        <div class="country-col">
          {col1.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="country-item"
              title={`Comprar en ${item.name} (${item.retailer})`}
            >
              <span class="country-name marker-underline">{item.name}</span>
            </a>
          ))}
        </div>

        <div class="country-col">
          {col2.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="country-item"
              title={`Comprar en ${item.name} (${item.retailer})`}
            >
              <span class="country-name marker-underline">{item.name}</span>
            </a>
          ))}
        </div>

        <div class="country-col">
          {col3.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="country-item"
              title={`Comprar en ${item.name} (${item.retailer})`}
            >
              <span class="country-name marker-underline">{item.name}</span>
            </a>
          ))}
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .compra-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow-x: hidden;
  }

  .compra-main {
    flex: 1;
    max-width: 1300px;
    margin: 0 auto;
    width: 100%;
    padding: 1rem 2.5rem 3rem 2.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .compra-header-block {
    text-align: center;
    margin-top: 1rem;
    margin-bottom: 3.5rem;
  }

  .compra-subtitle {
    font-family: var(--font-handwriting);
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    line-height: 1.3;
    color: var(--color-ink-black);
    font-weight: 700;
  }

  .countries-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 6rem;
    max-width: 1100px;
    width: 100%;
    margin-bottom: 4rem;
  }

  .country-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.8rem;
  }

  .country-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .country-item:hover {
    transform: scale(1.06);
  }

  .country-name {
    font-family: var(--font-amalia);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    color: var(--color-marker-red);
    letter-spacing: 0.05em;
    font-weight: 400;
  }

  .country-name.marker-underline::after {
    height: 5px;
    bottom: -3px;
  }

  .doodle-img {
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  .doodle-chairs-tu-yo {
    position: absolute;
    top: 8%;
    left: 8%;
    width: 120px;
    pointer-events: none;
  }

  .doodle-heart-compra {
    position: absolute;
    top: 9%;
    right: 12%;
    width: 95px;
    pointer-events: none;
  }

  .doodle-spiral-compra {
    position: absolute;
    bottom: 8%;
    left: 2%;
    width: 110px;
    pointer-events: none;
  }

  .doodle-envelope-compra {
    position: absolute;
    bottom: 8%;
    right: 26%;
    width: 110px;
    pointer-events: none;
  }

  .doodle-scratch-compra {
    position: absolute;
    bottom: 18%;
    right: 6%;
    width: 95px;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .countries-grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      margin-bottom: 2.5rem;
    }
    .doodle-chairs-tu-yo {
      width: 75px;
      left: 2%;
      top: 1%;
    }
    .doodle-heart-compra {
      width: 65px;
      right: 4%;
      top: 1%;
    }
    .doodle-envelope-compra {
      right: 8%;
      bottom: 2%;
      width: 80px;
    }
    .doodle-spiral-compra,
    .doodle-scratch-compra {
      display: none;
    }
  }
</style>
