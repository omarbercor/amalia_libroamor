---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SillasDoodleAnimated from '../components/SillasDoodleAnimated.astro';
import CorazonOjosDoodleAnimated from '../components/CorazonOjosDoodleAnimated.astro';
import Rayones04Animated from '../components/Rayones04Animated.astro';
import SpiralDoodleAnimated from '../components/SpiralDoodleAnimated.astro';
import countries from '../data/countries.json';

// Distribución de países en 3 columnas
const col1 = countries.filter(c => ['ar', 'ec', 'pe', 'us'].includes(c.id));
const col2 = countries.filter(c => ['br', 'es', 'pt', 've'].includes(c.id));
const col3 = countries.filter(c => ['co', 'mx', 'uy'].includes(c.id));
---

<Layout 
  title="Opciones de Compra Internacional — 10 Años | Amalia Andrade"
  description="Consigue la edición conmemorativa de los 10 años de 'Uno siempre cambia al amor de su vida (por otro amor o por otra vida)' en tu país."
>
  <div class="compra-page">
    <!-- Header idéntico al resto del sitio con botón volver al home -->
    <Header showBack={true} backUrl="/" />

    <main class="compra-main">
      <!-- Título Superior con tipografía manuscrita Mynerve -->
      <div class="compra-header-block">
        <h1 class="compra-title-mynerve">
          Activa el súper poder<br />
          de compra
        </h1>
      </div>

      <!-- Doodles vectoriales SVG y animados -->
      <!-- 1. Sillas TU + YO animadas (arriba a la izquierda) -->
      <div class="doodle-chairs-wrapper" aria-hidden="true">
        <SillasDoodleAnimated width="135" height="130" color="#EE2A22" />
      </div>

      <!-- 2. Corazón con ojos animado (arriba a la derecha) -->
      <div class="doodle-heart-wrapper" aria-hidden="true">
        <CorazonOjosDoodleAnimated width="115" height="122" />
      </div>

      <!-- 3. Rayones 04 decorativos (a la izquierda) -->
      <div class="doodle-rayones-wrapper" aria-hidden="true">
        <Rayones04Animated width="145" height="63" />
      </div>

      <!-- 4. Doodle sobre con corazón (abajo a la derecha) -->
      <div class="doodle-envelope-wrapper" aria-hidden="true">
        <img 
          src="/assets/compra/doodle-sobre-corazon.png" 
          alt="Doodle sobre con corazón" 
          class="doodle-compra-img"
          width="120"
          height="95"
        />
      </div>

      <!-- 5. Doodle espiral SVG animado (a la derecha) -->
      <div class="doodle-spiral-wrapper" aria-hidden="true">
        <SpiralDoodleAnimated width="42" height="270" />
      </div>

      <!-- 3 Columnas de Países en Tipografía Oficial Amalia Altas con subrayado interactivo -->
      <div class="countries-grid">
        <!-- Columna 1 -->
        <div class="country-col">
          {col1.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="country-item"
              title={`Comprar en ${item.name} — ${item.retailer}`}
            >
              <span class="country-name">{item.name}</span>
            </a>
          ))}
        </div>

        <!-- Columna 2 -->
        <div class="country-col">
          {col2.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="country-item"
              title={`Comprar en ${item.name} — ${item.retailer}`}
            >
              <span class="country-name">{item.name}</span>
            </a>
          ))}
        </div>

        <!-- Columna 3 -->
        <div class="country-col">
          {col3.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="country-item"
              title={`Comprar en ${item.name} — ${item.retailer}`}
            >
              <span class="country-name">{item.name}</span>
            </a>
          ))}
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .compra-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.5rem 3rem 1.8rem 3rem;
    overflow-x: hidden;
  }

  .compra-main {
    flex: 1;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    padding: 1rem 0 3.5rem 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Título con estilo manuscrito Mynerve */
  .compra-header-block {
    text-align: center;
    margin-top: 1rem;
    margin-bottom: 3.5rem;
    position: relative;
    z-index: 5;
  }

  .compra-title-mynerve {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: clamp(2.1rem, 4.2vw, 3rem);
    line-height: 1.25;
    color: var(--color-text-main, #1E1A18);
    font-weight: 400;
  }

  /* Cuadrícula de 3 columnas de países */
  .countries-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.8rem 5.5rem;
    max-width: 980px;
    width: 100%;
    margin-bottom: 4rem;
    position: relative;
    z-index: 6;
  }

  .country-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.8rem;
  }

  .country-item {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .country-item:hover {
    transform: none;
  }

  /* Tipografía oficial de Amalia para los nombres de países */
  .country-name {
    font-family: var(--font-primary-title, 'Amaliafont_altas', sans-serif);
    font-size: clamp(1.85rem, 2.9vw, 2.5rem);
    color: var(--color-marker-red, #EE2A22);
    letter-spacing: 0.05em;
    font-weight: 400;
    position: relative;
    display: inline-block;
    padding-bottom: 4px;
    transition: color 0.2s ease;
  }

  /* Hover en negro según lo solicitado */
  .country-item:hover .country-name {
    color: #000000;
  }

  /* Subrayado con plumón rojo estilo Amalia */
  .country-name::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: -4%;
    width: 108%;
    height: 4px;
    background-color: var(--color-marker-red, #EE2A22);
    border-radius: 3px;
    opacity: 0.95;
    transform: rotate(-0.6deg);
    transition: transform 0.22s ease, background-color 0.2s ease;
  }

  /* El subrayado también pasa a negro en hover sin crecer */
  .country-item:hover .country-name::after {
    background-color: #000000;
    transform: rotate(-0.6deg);
  }

  /* Posicionamiento de Doodles */
  .doodle-chairs-wrapper {
    position: absolute;
    top: 6%;
    left: 4%;
    width: 135px;
    z-index: 4;
    pointer-events: auto;
  }

  .doodle-heart-wrapper {
    position: absolute;
    top: 5%;
    right: 6%;
    width: 115px;
    z-index: 4;
    pointer-events: auto;
  }

  .doodle-rayones-wrapper {
    position: absolute;
    bottom: 8%;
    left: 2.5%;
    width: 145px;
    z-index: 3;
    pointer-events: auto;
  }

  .doodle-envelope-wrapper {
    position: absolute;
    bottom: 6%;
    right: 18%;
    width: 110px;
    z-index: 3;
    pointer-events: none;
    transition: transform 0.25s ease;
  }

  .doodle-spiral-wrapper {
    position: absolute;
    bottom: 4%;
    right: 2.5%;
    width: 48px;
    z-index: 3;
    pointer-events: auto;
  }

  .doodle-compra-img {
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  /* Responsive / Mobile */
  @media (max-width: 860px) {
    .compra-page {
      padding: 1.2rem 1.4rem 1.4rem 1.4rem;
    }

    .compra-main {
      padding: 1rem 0 2.5rem 0;
    }

    .compra-header-block {
      margin-bottom: 2.5rem;
    }

    .countries-grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      margin-bottom: 2.5rem;
    }

    .country-col {
      gap: 2.2rem;
    }

    .doodle-chairs-wrapper {
      width: 78px;
      left: 1%;
      top: 50%;
      transform: translateY(-50%);
    }

    .doodle-heart-wrapper {
      width: 68px;
      right: 2%;
      top: 50%;
      transform: translateY(-50%);
    }

    .doodle-envelope-wrapper {
      right: 6%;
      bottom: 2%;
      width: 75px;
    }

    .doodle-spiral-wrapper,
    .doodle-rayones-wrapper {
      display: none;
    }
  }
</style>
