---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoryCard from '../components/StoryCard.astro';
import FeedTitleAnimated from '../components/FeedTitleAnimated.astro';
import ButtonEnviarHistoria from '../components/ButtonEnviarHistoria.astro';
import ButtonOpcionesCompra from '../components/ButtonOpcionesCompra.astro';
import SeparadorSmall from '../components/SeparadorSmall.astro';
import storiesLocal from '../data/stories.json';
import cities from '../data/cities.json';

// Cargar historias desde WordPress REST API con fallback y combinación de pruebas
let fetchedStories: any[] = [];
try {
  const wpRes = await fetch('https://cmsamalia.stagings.website/?rest_route=/amalia/v1/historias&per_page=100', {
    headers: { 'Accept': 'application/json' }
  });
  if (wpRes.ok) {
    const wpData = await wpRes.json();
    if (Array.isArray(wpData) && wpData.length > 0) {
      fetchedStories = wpData.map((item: any) => {
        const rawContent = item.content?.rendered || '';
        const plainContent = rawContent.replace(/<[^>]*>?/gm, '').trim();
        const acf = item.acf || {};

        return {
          id: item.id,
          date: item.date,
          title: item.title,
          content: { rendered: plainContent || (item.title?.rendered ?? '') },
          tipo: item.tipo || acf.tipo || 'otro-amor',
          acf: {
            tipo: item.tipo || acf.tipo || 'otro-amor',
            categoria: acf.categoria || 'DESAMOR',
            autor: acf.autor || 'Anónimo',
            edad: acf.edad || '',
            ciudad: acf.ciudad || '',
            firma: acf.firma || ''
          }
        };
      });
    }
  }
} catch (e) {
  // Silencioso
}

// Combinar historias de WP con las historias de prueba locales evitando duplicar id
const wpIds = new Set(fetchedStories.map(s => s.id));
const stories = [...fetchedStories, ...storiesLocal.filter(s => !wpIds.has(s.id))];

// Cargar Taxonomía (Categorías principales y Subcategorías) directamente de WordPress
interface CategoryTerm {
  id: number;
  name: string;
  slug: string;
  parent: number;
}

let allTerms: CategoryTerm[] = [];
try {
  const catRes = await fetch('https://cmsamalia.stagings.website/?rest_route=/wp/v2/categoria_historia&per_page=100', {
    headers: { 'Accept': 'application/json' }
  });
  if (catRes.ok) {
    const data = await catRes.json();
    if (Array.isArray(data)) {
      allTerms = data;
    }
  }
} catch (e) {
  // Silencioso
}

// Categorías Padre (parent === 0)
const parentTerms = allTerms.filter(t => t.parent === 0);
// Si no hay o falló la conexión, fallback a las dos tradicionales
const finalParents = parentTerms.length > 0 ? parentTerms : [
  { id: 2, name: 'Por otro amor', slug: 'por-otro-amor', parent: 0 },
  { id: 8, name: 'O por otra vida', slug: 'por-otra-vida', parent: 0 }
];

// Mapa dinámico de categorías: { [parentSlug]: [subcategoriesNames] }
const dynamicCategoriesMap: Record<string, string[]> = {};
finalParents.forEach((parent) => {
  const children = allTerms.filter(t => t.parent === parent.id).map(t => t.name.toUpperCase());
  if (children.length > 0) {
    dynamicCategoriesMap[parent.slug] = children;
  } else if (parent.slug.includes('vida')) {
    dynamicCategoriesMap[parent.slug] = ["MUDANZA", "DIVORCIO", "DUELO", "SUPERACIÓN", "APRENDIZAJE"];
  } else {
    dynamicCategoriesMap[parent.slug] = ["INFIDELIDAD", "TRAICIÓN", "DESAMOR", "VENGANZA", "REENCUENTRO"];
  }
});

// Soporte de alias para retrocompatibilidad con slugs cortos 'otro-amor' y 'otra-vida'
if (dynamicCategoriesMap['por-otro-amor']) {
  dynamicCategoriesMap['otro-amor'] = dynamicCategoriesMap['por-otro-amor'];
}
if (dynamicCategoriesMap['por-otra-vida']) {
  dynamicCategoriesMap['otra-vida'] = dynamicCategoriesMap['por-otra-vida'];
}

// Mapeo de categorías de historias enriquecidas con su tipo
const enrichedStories = stories.map((item, idx) => {
  const itemType = (item.acf as any)?.tipo || (idx % 2 === 0 ? "otro-amor" : "otra-vida");
  return {
    ...item,
    tipo: itemType,
  };
});
---

<Layout 
  title="Lo que este libro me ha provocado — Historias | Amalia Andrade"
  description="Historias, anécdotas y pedazos de vida compartidos por lectores de 'Uno siempre cambia al amor de su vida'."
>
  <div class="stories-page">
    <!-- Header idéntico al home, con la flecha roja en la columna izquierda -->
    <Header showBack={true} backUrl="/" />

    <main class="stories-main">
      <!-- Sección Superior: Título Vectorial con subrayado animado SVG Draw + Hoja de Libreta -->
      <section class="hero-submission-section">
        <div class="hero-text-block">
          <h1 class="hero-title-h1">
            <FeedTitleAnimated />
          </h1>

          <!-- Bloque de textos centrado entre sí con separador_small animado -->
          <div class="hero-subtitles-centered">
            <p class="subtitle-handwritten-mynerve" id="heroDynamicSubtitle">
              Cuéntanos cómo ha tocado tu vida este libro
            </p>

            <!-- Separador small animado -->
            <SeparadorSmall width="140px" animated={true} id="heroSeparadorSmall" />

            <p class="subtitle-story-desc">
              Diez años de gente escribiéndome a las 3 a.m.<br />
              <span class="highlight-red">Ahora hay un lugar para eso.</span>
            </p>
          </div>
        </div>

        <div class="hero-form-wrapper">
          <!-- Hoja Rasgada de fondo con Formulario Interactivo encima -->
          <div class="torn-paper-form-card">
            <!-- Imagen de fondo de hoja rasgada -->
            <img 
              src="/assets/por-otro-amor/sube-tu-historia.png" 
              alt="Sube tu historia - Hoja de libreta" 
              class="torn-sheet-bg-img"
              width="460"
              height="530"
            />
            
            <!-- Formulario montado dentro de la hoja -->
            <form id="heroStoryForm" class="sheet-form-content">
              <!-- 1. Textarea arriba con contador de caracteres -->
              <div class="sheet-field textarea-field">
                <textarea 
                  id="sheetStoryContent" 
                  name="historia" 
                  rows="3" 
                  required 
                  placeholder="Escribe aquí tu pedacito de historia..."
                  class="sheet-textarea"
                  maxlength="500"
                ></textarea>
                <div class="sheet-char-counter" id="sheetCharCounter">
                  <span id="sheetCharNum">0</span>/500
                </div>
              </div>

              <!-- 2. Abajo: TIPO dinámico de WordPress -->
              <div class="sheet-inline-row type-row">
                <label for="sheetStoryType" class="sheet-label-inline">Tipo:</label>
                <div class="sheet-select-wrapper">
                  <select id="sheetStoryType" name="tipo" required class="sheet-select">
                    {finalParents.map((parent, idx) => {
                      const val = parent.slug.includes('vida') ? 'otra-vida' : (parent.slug.includes('amor') ? 'otro-amor' : parent.slug);
                      return (
                        <option value={val} selected={idx === 0}>
                          {parent.name}
                        </option>
                      );
                    })}
                  </select>
                  <span class="sheet-select-arrow" aria-hidden="true">▾</span>
                </div>
              </div>

              <!-- 3. Abajo: Categoría dinámica dependiente del tipo -->
              <div class="sheet-inline-row category-row">
                <label for="sheetStoryCategory" class="sheet-label-inline">Categoría:</label>
                <div class="sheet-select-wrapper">
                  <select id="sheetStoryCategory" name="categoria" required class="sheet-select">
                    <!-- Se poblará dinámicamente con JS según el tipo seleccionado -->
                    {(dynamicCategoriesMap['otro-amor'] || []).map((cat) => (
                      <option value={cat}>{cat.charAt(0) + cat.slice(1).toLowerCase()}</option>
                    ))}
                  </select>
                  <span class="sheet-select-arrow" aria-hidden="true">▾</span>
                </div>
              </div>

              <!-- 4. Abajo: Nombre y Edad en la misma fila -->
              <div class="sheet-row-two-col">
                <div class="sheet-inline-row author-inline-group">
                  <label for="sheetStoryAuthor" class="sheet-label-inline">Nombre:</label>
                  <input 
                    type="text" 
                    id="sheetStoryAuthor" 
                    name="autor" 
                    required 
                    placeholder="" 
                    class="sheet-input" 
                  />
                </div>
                <div class="sheet-inline-row age-inline-group">
                  <label for="sheetStoryAge" class="sheet-label-inline">Edad:</label>
                  <input 
                    type="text" 
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="3"
                    id="sheetStoryAge" 
                    name="edad" 
                    placeholder="" 
                    class="sheet-input sheet-input-age" 
                  />
                </div>
              </div>

              <!-- 5. Más abajo: Ciudad con Autocomplete / datalist -->
              <div class="sheet-inline-row city-row">
                <label for="sheetStoryCity" class="sheet-label-inline">Ciudad:</label>
                <div class="autocomplete-city-wrapper">
                  <input 
                    type="text" 
                    id="sheetStoryCity" 
                    name="ciudad" 
                    required 
                    list="citiesList"
                    placeholder="" 
                    class="sheet-input" 
                    autocomplete="off"
                  />
                  <datalist id="citiesList">
                    {cities.map((city) => (
                      <option value={city} />
                    ))}
                  </datalist>
                </div>
              </div>

              <!-- Mensaje de estado -->
              <div class="sheet-form-status" id="sheetFormStatusMsg" aria-live="polite"></div>
            </form>
          </div>

          <!-- Botón Enviar Historia SVG FUERA de la nota de papel -->
          <div class="external-submit-container">
            <ButtonEnviarHistoria id="sheetSubmitBtn" type="submit" />
          </div>

          <!-- Rayones 04 a la derecha con animación DrawSVG -->
          <div class="rayones-side-decoration" aria-hidden="true">
            <svg id="rayonesDrawSvg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 155.37 67.32" class="rayones-svg">
              <path class="rayones-draw-path" d="M138.37,64.98s-23.7-3.56-11.56-16.89,37.93,2.96,20.44,6.81-43.79-1.29-35.26-13.93,31.11-14.52,23.11,5.04-38.52,8.45-44.44,4.37-6.81-20.96,28.74-17.11-12.74,24.03-38.52,15.57-22.52-18.83,4.74-23.27,24.47,6.07,13.93,13.33-55.41,17.78-48.59-6.81,56.3-.89,31.11,5.63-57.19,6.52-53.93-6.52,48.89-15.7,26.37-.89S-3.26,35.64,14.23,23.79s56.59-10.96,24.59,1.78S-10.37,21.94,13.34,8.38s43.26-.89,34.37,2.96" fill="none" stroke="#EE2A22" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" />
            </svg>
          </div>
        </div>
      </section>

      <!-- Sección del Muro de Historias ("El chismecito") -->
      <section class="stories-wall-section" id="chismecitoSection">
        <!-- Separador small previo a "Aquí puedes leer el chismecito de lxs demás" -->
        <SeparadorSmall width="150px" animated={true} id="chismecitoSeparadorSmall" />

        <!-- Encabezado de chismecito -->
        <div class="chismecito-header-col">
          <h2 class="chismecito-title-mynerve">
            Aquí puedes leer el chismecito de lxs demás
          </h2>
        </div>

        <!-- Filtro unificado: un solo label "FILTRAR POR" seguido de los dos selects -->
        <div class="filters-selects-toolbar">
          <label for="filterTypeSelect" class="filter-main-label">FILTRAR POR:</label>
          
          <div class="filters-inputs-row">
            <!-- Select 1: Categoría Principal Dinámica -->
            <div class="filter-select-wrapper">
              <select id="filterTypeSelect" class="filter-select-input" aria-label="Filtrar por categoría">
                {finalParents.map((parent, idx) => {
                  const val = parent.slug.includes('vida') ? 'otra-vida' : (parent.slug.includes('amor') ? 'otro-amor' : parent.slug);
                  return (
                    <option value={val} selected={idx === 0}>
                      {parent.name}
                    </option>
                  );
                })}
              </select>
              <span class="filter-select-arrow" aria-hidden="true">▼</span>
            </div>

            <!-- Select 2: Subcategoría Dinámica -->
            <div class="filter-select-wrapper">
              <select id="filterCategorySelect" class="filter-select-input" aria-label="Filtrar por subcategoría">
                <option value="todas" selected>Todas</option>
                {(dynamicCategoriesMap['otro-amor'] || []).map((cat) => (
                  <option value={cat.toLowerCase()}>{cat.charAt(0) + cat.slice(1).toLowerCase()}</option>
                ))}
              </select>
              <span class="filter-select-arrow" aria-hidden="true">▼</span>
            </div>
          </div>
        </div>

        <!-- Datos Dinámicos de Taxonomías inyectados para el cliente -->
        <script id="wpCategoriesData" type="application/json" set:html={JSON.stringify(dynamicCategoriesMap)} />

        <!-- Cuadrícula de Tarjetas de Historias -->
        <div class="stories-grid" id="storiesGrid">
          {enrichedStories.map((item, index) => (
            <StoryCard 
              categoria={item.acf.categoria}
              texto={item.content.rendered}
              firma={item.acf.firma}
              index={index}
              tipo={item.tipo}
              id={item.id}
              slug={item.slug}
            />
          ))}
        </div>

        <!-- Mensaje de no resultados si una categoría está vacía -->
        <div class="no-stories-msg" id="noStoriesMsg" style="display: none;">
          <p class="no-stories-text">
            Aún no hay historias en esta categoría. 
            <a href="#heroStoryForm" class="create-story-link">crea una aquí</a>
          </p>
        </div>

        <!-- Paginación con Flechas Rojas (< >) y números con elipsis inteligente (...) -->
        <div class="pagination-controls" id="paginationControls">
          <button type="button" class="nav-arrow-circle" id="prevPageBtn" aria-label="Página anterior">
            <svg viewBox="0 0 24 24" class="arrow-icon" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <!-- Números de página con elipsis dinámica estilo 1 2 3 ... 1000 -->
          <div class="pagination-pages-list" id="paginationPagesList"></div>

          <button type="button" class="nav-arrow-circle" id="nextPageBtn" aria-label="Página siguiente">
            <svg viewBox="0 0 24 24" class="arrow-icon" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>

        <!-- Separador pequeño rojo debajo de la paginación -->
        <SeparadorSmall width="180px" />
      </section>

      <!-- Sección Frase de Amalia -->
      <section class="amalia-quote-section">
        <blockquote class="amalia-quote-text-box">
          <p class="amalia-quote-paragraph">
            &ldquo;Quizá crecer también sea eso: volver a nuestras propias historias y descubrir qué seguimos pensando, qué ya no, qué borraríamos y qué todavía defenderíamos con la vida. Este libro ya no es exactamente el mismo y, por suerte, ni ustedes ni yo tampoco&rdquo;.
          </p>
        </blockquote>

        <!-- Frase insignia en rojo y con subrayado animado -->
        <div class="quote-signature-banner">
          <svg 
            viewBox="0 0 980 130" 
            class="quote-banner-svg" 
            aria-label="UNO SIEMPRE CAMBIA EL AMOR DE SU VIDA POR OTRO AMOR O POR OTRA VIDA"
          >
            <!-- Línea 1 de texto en Amaliafont_altas en rojo -->
            <text class="banner-title-line" x="490" y="55" text-anchor="middle">
              UNO SIEMPRE CAMBIA EL AMOR DE SU VIDA
            </text>
            <!-- Línea 2 de texto en Amaliafont_altas en rojo -->
            <text class="banner-title-line" x="490" y="102" text-anchor="middle">
              POR OTRO AMOR O POR OTRA VIDA
            </text>
            <!-- Subrayado animado estilo plumón rojo -->
            <path 
              id="quoteBannerUnderline" 
              class="banner-underline-path" 
              d="M 60,118 Q 490,110 920,122" 
              fill="none" 
              stroke="#EE2A22" 
              stroke-width="6.5" 
              stroke-linecap="round" 
              stroke-linejoin="round"
            />
          </svg>
        </div>
      </section>

      <!-- Botón Ver Opciones de Compra (centrado, debajo de la frase de Amalia tanto en desktop como en mobile) -->
      <div class="purchase-cta-block">
        <ButtonOpcionesCompra />
      </div>
    </main>

    <Footer />
  </div>

  <!-- Modal para leer la historia completa al hacer clic en una tarjeta -->
  <dialog class="story-detail-modal" id="storyDetailModal" aria-labelledby="detailModalCategory">
    <div class="story-detail-dialog-card">
      <!-- Botón cerrar estilo manuscrito -->
      <button type="button" class="story-detail-close-btn" id="closeStoryDetailModalBtn" aria-label="Cerrar historia">✕</button>
      
      <div class="story-detail-header">
        <span class="story-detail-category" id="detailModalCategory">INFIDELIDAD</span>
      </div>

      <div class="story-detail-body">
        <p class="story-detail-full-text" id="detailModalText"></p>
      </div>

      <div class="story-detail-footer">
        <button type="button" class="story-share-link-btn" id="copyStoryShareLinkBtn" aria-label="Copiar enlace para compartir esta historia">
          <svg viewBox="0 0 24 24" class="share-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="copyShareBtnText">Compartir</span>
        </button>
        <span class="story-detail-signature" id="detailModalSignature">— Anónimo</span>
      </div>
    </div>
  </dialog>
</Layout>

<style>
  .stories-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.5rem 3rem 1.8rem 3rem;
    overflow-x: hidden;
  }

  .stories-main {
    flex: 1;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    padding: 1.5rem 0 3rem 0;
  }

  /* Sección Superior: Título y Hoja */
  .hero-submission-section {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 3.5rem;
    margin-top: 1rem;
    margin-bottom: 3.5rem;
    position: relative;
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 580px;
  }

  .hero-title-h1 {
    margin: 0;
    padding: 0;
  }

  .hero-subtitles-centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    margin-top: 0.5rem;
  }

  /* Tipografía Mynerve estricta solicitada por el usuario: 2rem en desktop */
  .subtitle-handwritten-mynerve {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 2rem;
    color: var(--color-text-main, #1E1A18);
    font-weight: 400;
    line-height: 1.25;
    text-align: center;
    max-width: 75%;
    margin: 0 auto;
  }

  .subtitle-story-desc {
    font-family: var(--font-regular, 'Open Sans', sans-serif);
    font-size: 1.12rem;
    color: var(--color-text-muted, #554E48);
    line-height: 1.5;
    text-align: center;
  }

  .highlight-red {
    color: var(--color-marker-red, #EE2A22);
    font-weight: 600;
  }

  /* Hoja Rasgada y Formulario Integrado */
  .hero-form-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 5;
    width: 100%;
  }

  .torn-paper-form-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 14px 28px rgba(30, 26, 24, 0.08));
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .torn-paper-form-card:hover {
    transform: translateY(-3px);
  }

  /* Imagen de fondo de la hoja */
  .torn-sheet-bg-img {
    width: 100%;
    height: 100%;
    min-height: 525px;
    object-fit: fill;
    display: block;
    mix-blend-mode: multiply;
    pointer-events: none;
    user-select: none;
  }

  /* Formulario que se ubica exactamente dentro del área blanca de la hoja */
  .sheet-form-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    /* Padding duplicado en top y aumentado a los lados */
    padding: 7.6rem 3.8rem 2.6rem 3.8rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.55rem;
    z-index: 2;
  }

  .sheet-field {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    position: relative;
  }

  /* Filas donde label e input/select van en el mismo renglón */
  .sheet-inline-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
  }

  .sheet-label-inline {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 1.15rem;
    color: var(--color-text-main, #1E1A18);
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    line-height: 1;
  }

  /* Textarea estilo libreta manuscrita */
  .textarea-field {
    flex: none;
    height: 72px;
    margin-bottom: 0.1rem;
    position: relative;
  }

  .sheet-textarea {
    width: 100%;
    height: 100%;
    resize: none;
    background: rgba(255, 255, 255, 0.55);
    border: 1.5px dashed rgba(212, 200, 182, 0.9);
    border-radius: 8px;
    padding: 0.4rem 0.65rem 1rem 0.65rem;
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--color-text-main, #1E1A18);
    outline: none;
    box-sizing: border-box;
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .sheet-char-counter {
    position: absolute;
    bottom: 4px;
    right: 8px;
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 0.85rem;
    color: #8C827A;
    pointer-events: none;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .sheet-char-counter.near-limit {
    color: var(--color-marker-red, #EE2A22);
    font-weight: 700;
  }

  .sheet-textarea::placeholder {
    color: rgba(110, 102, 95, 0.65);
    font-size: 1.02rem;
  }

  .sheet-textarea:focus {
    background: #FFFFFF;
    border: 1.5px solid var(--color-marker-red, #EE2A22);
