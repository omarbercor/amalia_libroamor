---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Cosas que no están en el libro pero deberían estar — 10 Años | Amalia Andrade"
  description="Archivos inéditos, bocetos iniciales, canciones y recuerdos conmemorativos de 'Uno siempre cambia al amor de su vida'."
>
  <div class="multimedia-page">
    <Header showBack={true} />

    <main class="multimedia-main">
      <!-- Sección del Carrusel Multimedia -->
      <section class="carousel-section">
        <!-- Doodle Corazón + Curita -->
        <div class="doodle-heart-bandaid" aria-hidden="true">
          <img 
            src="/assets/o-por-otra-vida/doodle-corazon-curita.png" 
            alt="Doodle corazón y curita" 
            class="doodle-img"
            width="140"
            height="90"
          />
        </div>

        <div class="carousel-header">
          <h1 class="carousel-title">
            <span class="line-1">COSAS QUE NO</span><br />
            <span class="line-2 marker-underline">ESTÁN EN EL LIBRO</span><br />
            <span class="line-3 marker-underline">PERO DEBERÍAN</span>
          </h1>

          <p class="carousel-subtitle">
            Cuéntanos cómo ha tocado tu vida este libro
          </p>
        </div>

        <!-- Carrusel con los Assets Oficiales -->
        <div class="carousel-container-outer">
          <div class="carousel-track" id="multimediaCarouselTrack">
            <!-- 1. Polaroid Roja -->
            <div class="carousel-item">
              <img 
                src="/assets/o-por-otra-vida/polaroid-roja.png" 
                alt="Polaroid Roja con boceto" 
                class="carousel-asset-img"
                width="360"
                height="410"
              />
            </div>

            <!-- 2. Polaroid Blanca Inclinada -->
            <div class="carousel-item">
              <img 
                src="/assets/o-por-otra-vida/polaroid-blanca-inclinada.png" 
                alt="Polaroid Blanca Inclinada" 
                class="carousel-asset-img"
                width="360"
                height="270"
              />
            </div>

            <!-- 3. iPod Classic con Música de Juan Gabriel -->
            <div class="carousel-item ipod-interactive-item" id="ipodItem" role="button" tabindex="0" title="Haz clic para reproducir muestra">
              <img 
                src="/assets/o-por-otra-vida/ipod-classic.png" 
                alt="iPod Classic retro - No me vuelvo a enamorar (Juan Gabriel)" 
                class="carousel-asset-img ipod-img"
                width="210"
                height="260"
              />
              <div class="ipod-audio-badge" id="ipodAudioBadge">
                <span>▶ Toca para escuchar</span>
              </div>
            </div>

            <!-- 4. Polaroid Blanca con Corazones y Plumón -->
            <div class="carousel-item">
              <img 
                src="/assets/o-por-otra-vida/polaroid-blanca-plumon.png" 
                alt="Polaroid Blanca con doodle de corazones y plumón apoyado" 
                class="carousel-asset-img"
                width="420"
                height="415"
              />
            </div>
          </div>
        </div>

        <!-- Controles del Carrusel (< >) -->
        <div class="carousel-nav-controls">
          <button type="button" class="nav-arrow-btn" id="carouselPrevBtn" aria-label="Desplazar a la izquierda">&lt;</button>
          <button type="button" class="nav-arrow-btn" id="carouselNextBtn" aria-label="Desplazar a la derecha">&gt;</button>
        </div>
      </section>

      <!-- Divisor horizontal -->
      <div class="marker-divider-line" aria-hidden="true">
        <svg viewBox="0 0 1000 8" preserveAspectRatio="none" class="divider-svg">
          <path d="M0 4Q250 1 500 4T1000 4" stroke="#E02826" stroke-width="3.5" fill="none" />
        </svg>
      </div>

      <!-- Sección SOBRE AMALIA -->
      <section class="about-amalia-section" id="sobre-amalia">
        <div class="about-title-wrapper">
          <img 
            src="/assets/o-por-otra-vida/sobre-amalia-rotulo.png" 
            alt="Sobre Amalia" 
            class="sobre-amalia-title-img"
            width="260"
            height="90"
          />
        </div>

        <div class="about-content-grid">
          <!-- Polaroid de Amalia con cinta roja original -->
          <div class="about-polaroid-col">
            <img 
              src="/assets/o-por-otra-vida/polaroid-amalia-cinta.png" 
              alt="Foto de Amalia Andrade fijada con cinta adhesiva roja" 
              class="polaroid-amalia-img"
              width="380"
              height="390"
            />
          </div>

          <!-- Texto biográfico + Firma -->
          <div class="about-text-col">
            <p class="bio-paragraph">
              Amalia Andrade nació en Cali, Colombia. Es periodista, ilustradora y fenómeno viral en las redes sociales. Ha vendido más de 1 millón de ejemplares de sus libros y expuesto en varias galerías colombianas.
            </p>

            <img 
              src="/assets/o-por-otra-vida/firma-texto-amalia.png" 
              alt="Texto de Amalia" 
              class="firma-amalia-img"
              width="200"
              height="50"
            />
          </div>
        </div>

        <!-- Botón Ver Opciones de Compra -->
        <div class="about-purchase-cta">
          <a href="/compra" class="btn-pill-action">
            Ver opciones de compra
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .multimedia-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.5rem 3rem 1.8rem 3rem;
    overflow-x: hidden;
  }

  .multimedia-main {
    flex: 1;
    max-width: 1350px;
    margin: 0 auto;
    width: 100%;
    padding: 1rem 0 3rem 0;
  }

  /* Sección Carrusel */
  .carousel-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    margin-bottom: 3rem;
  }

  .doodle-heart-bandaid {
    position: absolute;
    top: 0;
    left: 4%;
    width: 130px;
    pointer-events: none;
  }

  .doodle-img {
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  .carousel-header {
    text-align: center;
    margin-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .carousel-title {
    font-family: var(--font-amalia);
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    line-height: 1.25;
    color: var(--color-marker-red);
    letter-spacing: 0.03em;
    font-weight: 400;
  }

  .carousel-subtitle {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 2rem;
    color: var(--color-text-main, #1E1A18);
    font-weight: 400;
    margin-top: 0.8rem;
    max-width: 75%;
    margin-left: auto;
    margin-right: auto;
  }

  /* Carrusel Track */
  .carousel-container-outer {
    width: 100%;
    overflow-x: auto;
    padding: 1.5rem 0.5rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
    cursor: grab;
  }

  .carousel-container-outer::-webkit-scrollbar {
    display: none;
  }

  .carousel-track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    width: max-content;
    margin: 0 auto;
    min-width: 100%;
  }

  .carousel-item {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .carousel-item:hover {
    transform: scale(1.03);
  }

  .carousel-asset-img {
    height: auto;
    display: block;
    mix-blend-mode: multiply;
    max-height: 420px;
    width: auto;
  }

  .ipod-interactive-item {
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ipod-img {
    max-height: 270px;
  }

  .ipod-audio-badge {
    margin-top: 0.6rem;
    background: rgba(226, 39, 35, 0.1);
    border: 1px solid var(--color-marker-red);
    color: var(--color-marker-red);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-family: var(--font-notes);
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .ipod-interactive-item:hover .ipod-audio-badge {
    background: var(--color-marker-red);
    color: #FFFFFF;
  }

  .carousel-nav-controls {
    display: flex;
    justify-content: center;
    gap: 1.8rem;
    margin-top: 1.5rem;
  }

  .nav-arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--color-marker-red);
    background: transparent;
    color: var(--color-marker-red);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-amalia);
    font-size: 1.5rem;
    transition: all 0.2s ease;
  }

  .nav-arrow-btn:hover {
    background: var(--color-marker-red);
    color: #FFFFFF;
  }

  .marker-divider-line {
    width: 100%;
    max-width: 900px;
    margin: 2.5rem auto 3.5rem auto;
    height: 12px;
  }

  .divider-svg {
    width: 100%;
    height: 100%;
  }

  /* Sección SOBRE AMALIA */
  .about-amalia-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 1.5rem 0;
  }

  .about-title-wrapper {
    margin-bottom: 2.5rem;
  }

  .sobre-amalia-title-img {
    height: 65px;
    width: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  .about-content-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: center;
    max-width: 900px;
    width: 100%;
  }

  .about-polaroid-col {
    display: flex;
    justify-content: center;
  }

  .polaroid-amalia-img {
    max-width: 380px;
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  .about-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .bio-paragraph {
    font-family: var(--font-notes);
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--color-ink-black);
  }

  .firma-amalia-img {
    height: 35px;
    width: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  .about-purchase-cta {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }

  @media (max-width: 860px) {
    .multimedia-page {
      padding: 1.2rem 1.4rem 1.4rem 1.4rem;
    }
    .multimedia-main {
      padding: 1rem 0 2rem 0;
    }
    .about-content-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }
    .about-text-col {
      align-items: center;
    }
    .carousel-track {
      justify-content: flex-start;
    }
    .doodle-heart-bandaid {
      width: 80px;
      top: -10px;
      left: 1%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('multimediaCarouselTrack')?.parentElement;
    const prevBtn = document.getElementById('carouselPrevBtn');
    const nextBtn = document.getElementById('carouselNextBtn');
    const ipodItem = document.getElementById('ipodItem');
    const badge = document.getElementById('ipodAudioBadge');

    prevBtn?.addEventListener('click', () => {
      container?.scrollBy({ left: -320, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      container?.scrollBy({ left: 320, behavior: 'smooth' });
    });

    // Muestra interactiva de audio
    let audioCtx: AudioContext | null = null;
    let isPlaying = false;

    ipodItem?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (badge) {
        badge.textContent = isPlaying ? '❚❚ Sonando: Juan Gabriel' : '▶ Toca para escuchar';
      }
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        if (isPlaying) {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(392, audioCtx.currentTime); // Sol
          osc.frequency.setValueAtTime(440, audioCtx.currentTime + 0.2); // La
          osc.frequency.setValueAtTime(523.25, audioCtx.currentTime + 0.4); // Do
          gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.6);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.65);
        }
      } catch (e) {
        // Fallback
      }
    });
  });
</script>
