---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoryCard from '../components/StoryCard.astro';
import FeedTitleAnimated from '../components/FeedTitleAnimated.astro';
import ButtonEnviarHistoria from '../components/ButtonEnviarHistoria.astro';
import ButtonOpcionesCompra from '../components/ButtonOpcionesCompra.astro';
import SeparadorSmall from '../components/SeparadorSmall.astro';
import stories from '../data/stories.json';

// Categorías del feed de historias
const categories = ["TODAS", "DUELO", "MUDANZAS", "AMISTAD", "DESAMOR", "CRECIMIENTO"];
---

<Layout 
  title="Lo que este libro me ha provocado — Historias | Amalia Andrade"
  description="Historias, anécdotas y pedazos de vida compartidos por lectores de 'Uno siempre cambia al amor de su vida'."
>
  <div class="stories-page">
    <!-- Header idéntico al home, con la flecha roja en la columna izquierda -->
    <Header showBack={true} backUrl="/" />

    <main class="stories-main">
      <!-- Sección Superior: Título Vectorial con subrayado animado SVG Draw + Hoja de Libreta -->
      <section class="hero-submission-section">
        <div class="hero-text-block">
          <h1 class="hero-title-h1">
            <FeedTitleAnimated />
          </h1>

          <!-- Bloque de textos centrado entre sí con separador_small animado -->
          <div class="hero-subtitles-centered">
            <p class="subtitle-handwritten-mynerve">
              Cuéntanos cómo ha tocado tu vida este libro
            </p>

            <!-- Separador small animado -->
            <SeparadorSmall width="140px" animated={true} id="heroSeparadorSmall" />

            <p class="subtitle-story-desc">
              Diez años de gente escribiéndome a las 3 a.m.<br />
              <span class="highlight-red">Ahora hay un lugar para eso.</span>
            </p>
          </div>
        </div>

        <div class="hero-form-wrapper">
          <!-- Hoja Rasgada Original de Amalia + Botón Enviar Historia SVG -->
          <div class="torn-paper-card" id="openStoryModalBtn" role="button" tabindex="0" title="Haz clic para subir tu historia">
            <div class="torn-sheet-box">
              <img 
                src="/assets/por-otro-amor/sube-tu-historia.png" 
                alt="Sube tu historia - Hoja de libreta" 
                class="torn-sheet-img"
                width="460"
                height="360"
              />
            </div>
            
            <!-- Botón SVG de 'ENVIAR HISTORIA' -->
            <div class="submit-btn-container">
              <ButtonEnviarHistoria id="triggerModalButton" />
            </div>
          </div>

          <!-- Rayones 04 a la derecha a la altura del centro de la nota con animación DrawSVG -->
          <div class="rayones-side-decoration" aria-hidden="true">
            <svg id="rayonesDrawSvg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 155.37 67.32" class="rayones-svg">
              <path class="rayones-draw-path" d="M138.37,64.98s-23.7-3.56-11.56-16.89,37.93,2.96,20.44,6.81-43.79-1.29-35.26-13.93,31.11-14.52,23.11,5.04-38.52,8.45-44.44,4.37-6.81-20.96,28.74-17.11-12.74,24.03-38.52,15.57-22.52-18.83,4.74-23.27,24.47,6.07,13.93,13.33-55.41,17.78-48.59-6.81,56.3-.89,31.11,5.63-57.19,6.52-53.93-6.52,48.89-15.7,26.37-.89S-3.26,35.64,14.23,23.79s56.59-10.96,24.59,1.78S-10.37,21.94,13.34,8.38s43.26-.89,34.37,2.96" fill="none" stroke="#EE2A22" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" />
            </svg>
          </div>
        </div>
      </section>

      <!-- Sección del Muro de Historias ("El chismecito") -->
      <section class="stories-wall-section">
        <!-- Separador small previo a "Aquí puedes leer el chismecito de lxs demás" -->
        <SeparadorSmall width="150px" animated={true} id="chismecitoSeparadorSmall" />

        <!-- Encabezado de chismecito: centrado y mide el ancho exacto de 1 columna de la cuadrícula -->
        <div class="chismecito-header-col">
          <h2 class="chismecito-title-mynerve">
            Aquí puedes leer el chismecito de lxs demás
          </h2>
        </div>

        <!-- Cuadrícula de Tarjetas de Historias (9 por página como en la maqueta de escritorio 3x3) -->
        <div class="stories-grid" id="storiesGrid">
          {stories.map((item, index) => (
            <StoryCard 
              categoria={item.acf.categoria}
              texto={item.content.rendered}
              firma={item.acf.firma}
              index={index}
            />
          ))}
        </div>

        <!-- Paginación con Flechas Rojas (< >) con círculos rojos idénticos a las maquetas -->
        <div class="pagination-controls">
          <button type="button" class="nav-arrow-circle" id="prevPageBtn" aria-label="Anterior">
            <svg viewBox="0 0 24 24" class="arrow-icon" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button type="button" class="nav-arrow-circle" id="nextPageBtn" aria-label="Siguiente">
            <svg viewBox="0 0 24 24" class="arrow-icon" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>

        <!-- Separador pequeño rojo debajo de la paginación -->
        <SeparadorSmall width="180px" />
      </section>

      <!-- Sección Frase de Amalia -->
      <section class="amalia-quote-section">
        <div class="quote-rotulo-wrapper">
          <img 
            src="/assets/por-otro-amor/frase-amalia-rotulo.png" 
            alt="Frase de Amalia" 
            class="quote-rotulo-img"
            width="290"
            height="100"
          />
        </div>
      </section>

      <!-- Botón Ver Opciones de Compra (centrado, debajo de la frase de Amalia tanto en desktop como en mobile) -->
      <div class="purchase-cta-block">
        <ButtonOpcionesCompra />
      </div>
    </main>

    <!-- Modal de Envío de Historias -->
    <dialog class="story-modal-dialog" id="storyModalDialog">
      <div class="modal-inner-sheet">
        <button class="modal-close-btn" id="closeStoryModalBtn" aria-label="Cerrar modal">✕</button>

        <h2 class="modal-title font-primary-title">Cuéntanos tu historia</h2>

        <form id="submitStoryForm" class="notebook-story-form">
          <div class="form-group">
            <label for="storyCategory">Categoría:</label>
            <select id="storyCategory" name="categoria" required class="notebook-select">
              <option value="DUELO">Duelo</option>
              <option value="MUDANZAS">Mudanzas</option>
              <option value="AMISTAD">Amistad</option>
              <option value="DESAMOR">Desamor</option>
              <option value="CRECIMIENTO">Crecimiento</option>
            </select>
          </div>

          <div class="form-group">
            <label for="storyContent">Tu recuerdo o historia:</label>
            <textarea 
              id="storyContent" 
              name="historia" 
              rows="4" 
              required 
              placeholder="Escribe aquí tu pedacito de vida..."
              class="notebook-textarea"
              maxlength="400"
            ></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="storyAuthor">Nombre o apodo:</label>
              <input type="text" id="storyAuthor" name="autor" required placeholder="Ej. Vale" class="notebook-input" />
            </div>
            <div class="form-group">
              <label for="storyAge">Edad:</label>
              <input type="text" id="storyAge" name="edad" placeholder="Ej. 34" class="notebook-input" />
            </div>
          </div>

          <div class="form-group">
            <label for="storyCity">Ciudad:</label>
            <input type="text" id="storyCity" name="ciudad" required placeholder="Ej. Medellín" class="notebook-input" />
          </div>

          <div class="form-actions">
            <ButtonEnviarHistoria id="modalSubmitBtn" type="submit" />
          </div>

          <div class="form-status" id="formStatusMsg" aria-live="polite"></div>
        </form>
      </div>
    </dialog>

    <Footer />
  </div>
</Layout>

<style>
  .stories-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.5rem 3rem 1.8rem 3rem;
    overflow-x: hidden;
  }

  .stories-main {
    flex: 1;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    padding: 1.5rem 0 3rem 0;
  }

  /* Sección Superior: Título y Hoja */
  .hero-submission-section {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 3.5rem;
    margin-top: 1rem;
    margin-bottom: 3.5rem;
    position: relative;
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-width: 580px;
  }

  .hero-title-h1 {
    margin: 0;
    padding: 0;
  }

  .hero-subtitles-centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    margin-top: 0.5rem;
  }

  /* Tipografía Mynerve estricta solicitada por el usuario: 2rem en desktop */
  .subtitle-handwritten-mynerve {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 2rem;
    color: var(--color-text-main, #1E1A18);
    font-weight: 400;
    line-height: 1.25;
    text-align: center;
    max-width: 75%;
    margin: 0 auto;
  }

  .subtitle-story-desc {
    font-family: var(--font-regular, 'Open Sans', sans-serif);
    font-size: 1.12rem;
    color: var(--color-text-muted, #554E48);
    line-height: 1.5;
    text-align: center;
  }

  .highlight-red {
    color: var(--color-marker-red, #EE2A22);
    font-weight: 600;
  }

  /* Hoja Rasgada y Botón Enviar Historia */
  .hero-form-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 5;
  }

  .torn-paper-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    width: 100%;
    max-width: 440px;
  }

  .torn-sheet-box {
    width: 100%;
    display: flex;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .torn-paper-card:hover .torn-sheet-box {
    transform: translateY(-4px) rotate(-0.5deg);
  }

  .torn-sheet-img {
    width: 100%;
    max-width: 420px;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  .submit-btn-container {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  /* Rayones 04 a la derecha a la altura del centro de la nota */
  .rayones-side-decoration {
    position: absolute;
    right: -135px;
    top: calc(50% - 35px);
    transform: translateY(-50%);
    width: 140px;
    pointer-events: none;
    z-index: 10;
  }

  .rayones-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .rayones-draw-path {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: rayonesDrawAnim 2.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    animation-delay: 0.3s;
  }

  @keyframes rayonesDrawAnim {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Muro de Historias ("El chismecito") */
  .stories-wall-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 2.5rem 0 2rem 0;
    width: 100%;
  }

  /* Contenedor del título que mide exactamente el ancho de 1 columna (de las 3 de la grilla) y está en el centro */
  .chismecito-header-col {
    width: 100%;
    max-width: 380px; /* Ancho idéntico al de una columna de tarjetas */
    margin: 0.5rem auto 2.5rem auto;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  /* Título chismecito en Mynerve estricto: 2rem en desktop */
  .chismecito-title-mynerve {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 2rem;
    color: var(--color-text-main, #1E1A18);
    text-align: center;
    font-weight: 400;
    line-height: 1.25;
    margin: 0;
    width: 100%;
  }

  /* Grilla 3 columnas desktop */
  .stories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.2rem 2rem;
    width: 100%;
    margin-bottom: 2.8rem;
  }

  /* Controles de Paginación (< >) */
  .pagination-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .nav-arrow-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2.5px solid var(--color-marker-red, #EE2A22);
    background: transparent;
    color: var(--color-marker-red, #EE2A22);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, color 0.2s ease;
  }

  .nav-arrow-circle:hover {
    background-color: var(--color-marker-red, #EE2A22);
    color: #FFFFFF;
    transform: scale(1.08);
  }

  .nav-arrow-circle:active {
    transform: scale(0.95);
  }

  .arrow-icon {
    width: 22px;
    height: 22px;
  }

  /* Frase de Amalia */
  .amalia-quote-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 3.5rem 0 2rem 0;
    text-align: center;
    width: 100%;
  }

  .quote-rotulo-wrapper {
    display: flex;
    justify-content: center;
  }

  .quote-rotulo-img {
    height: 85px;
    width: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  /* Botón de compra (centrado debajo de la frase de Amalia) */
  .purchase-cta-block {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  /* Modal de Envío de Historias */
  .story-modal-dialog {
    border: none;
    border-radius: 12px;
    padding: 0;
    background: transparent;
    max-width: 580px;
    width: 90vw;
    margin: auto;
    box-shadow: 0 24px 60px rgba(0,0,0,0.35);
    overflow: hidden;
  }

  .story-modal-dialog::backdrop {
    background: rgba(25, 20, 15, 0.65);
    backdrop-filter: blur(4px);
  }

  .modal-inner-sheet {
    background: #FAF5EB;
    padding: 2.2rem 2rem;
    border-radius: 12px;
    border: 2px solid #D5C8B4;
    position: relative;
    box-shadow: inset 0 0 30px rgba(0,0,0,0.03);
    overflow: hidden;
  }

  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    font-size: 1.6rem;
    color: var(--color-text-muted, #554E48);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0.3rem 0.6rem;
    line-height: 1;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .modal-close-btn:hover {
    color: var(--color-marker-red, #EE2A22);
    transform: scale(1.15);
  }

  .modal-title {
    font-size: 2.2rem;
    color: var(--color-marker-red, #EE2A22);
    margin-bottom: 0.4rem;
    font-weight: 400;
  }

  .modal-subtitle {
    font-family: var(--font-regular, 'Open Sans', sans-serif);
    font-size: 1.05rem;
    color: var(--color-text-muted, #554E48);
    margin-bottom: 1.6rem;
  }

  .notebook-story-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 1.2rem;
    color: var(--color-text-main, #1E1A18);
  }

  .notebook-input,
  .notebook-select,
  .notebook-textarea {
    font-family: var(--font-regular, 'Open Sans', sans-serif);
    font-size: 1rem;
    padding: 0.7rem 0.95rem;
    border: 1.5px solid #D4C8B6;
    border-radius: 6px;
    background: #FFFFFF;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .notebook-input:focus,
  .notebook-select:focus,
  .notebook-textarea:focus {
    border-color: var(--color-marker-red, #EE2A22);
    box-shadow: 0 0 0 3px rgba(238, 42, 34, 0.12);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .form-actions {
    display: flex;
    justify-content: center;
    margin-top: 0.6rem;
  }

  .form-status {
    text-align: center;
    font-family: var(--font-secondary-title, 'Mynerve', cursive);
    font-size: 1.3rem;
    color: var(--color-marker-red, #EE2A22);
    min-height: 1.6rem;
  }

  /* Responsive / Mobile */
  @media (max-width: 960px) {
    .stories-page {
      padding: 1.2rem 1.4rem 1.4rem 1.4rem;
    }

    .stories-main {
      padding: 1rem 0 2rem 0;
    }

    .hero-submission-section {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.2rem;
      margin-bottom: 2rem;
    }

    .hero-text-block {
      align-items: center;
      max-width: 100%;
    }

    .rayones-side-decoration {
      display: none;
    }

    .stories-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('storyModalDialog') as HTMLDialogElement;
    const openCard = document.getElementById('openStoryModalBtn');
    const closeBtn = document.getElementById('closeStoryModalBtn');
    const form = document.getElementById('submitStoryForm') as HTMLFormElement;
    const statusMsg = document.getElementById('formStatusMsg');
    const cards = document.querySelectorAll('.story-note-card') as NodeListOf<HTMLElement>;
    const prevBtn = document.getElementById('prevPageBtn');
    const nextBtn = document.getElementById('nextPageBtn');

    // Apertura y cierre del modal
    openCard?.addEventListener('click', () => dialog?.showModal());
    closeBtn?.addEventListener('click', () => dialog?.close());

    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      if (
        e.clientY < rect.top ||
        e.clientY > rect.bottom ||
        e.clientX < rect.left ||
        e.clientX > rect.right
      ) {
        dialog.close();
      }
    });

    // Envío del formulario
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!statusMsg) return;
      statusMsg.textContent = 'Guardando historia... ✨';
      setTimeout(() => {
        statusMsg.textContent = '¡Historia enviada con éxito! Pasará a moderación.';
        form.reset();
        setTimeout(() => {
          dialog?.close();
          statusMsg.textContent = '';
        }, 2200);
      }, 700);
    });

    // Filtro por query params (ej. ?filtro=duelo o ?tipo=amor o ?categoria=...)
    const urlParams = new URLSearchParams(window.location.search);
    const queryFilter = (urlParams.get('filtro') || urlParams.get('categoria') || urlParams.get('tipo') || '').toLowerCase();

    if (queryFilter && queryFilter !== 'todas') {
      cards.forEach((card) => {
        const cat = (card.getAttribute('data-category') || '').toLowerCase();
        if (cat === queryFilter || (queryFilter === 'amor' && cat === 'desamor')) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Paginación con feedback interactivo suave
    let currentPage = 1;
    const itemsPerPage = 9;
    const totalPages = Math.ceil(cards.length / itemsPerPage) || 1;

    const renderPagination = (page: number) => {
      // Si hay filtro activo por query no paginamos estricto
      if (queryFilter && queryFilter !== 'todas') return;

      cards.forEach((card, idx) => {
        const start = (page - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        if (idx >= start && idx < end) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    };

    renderPagination(currentPage);

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPagination(currentPage);
        document.getElementById('storiesGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    nextBtn?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderPagination(currentPage);
        document.getElementById('storiesGrid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
