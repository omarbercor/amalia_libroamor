---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoryCard from '../components/StoryCard.astro';
import stories from '../data/stories.json';

const categories = ["TODAS", "DUELO", "MUDANZAS", "AMISTAD", "DESAMOR", "CRECIMIENTO"];
---

<Layout 
  title="Lo que este libro me ha provocado — Historias | Amalia Andrade"
  description="Historias, anécdotas y pedazos de vida compartidos por lectores de 'Uno siempre cambia al amor de su vida'."
>
  <div class="stories-page">
    <Header showBack={true} />

    <main class="stories-main">
      <!-- Sección Superior: Título + Hoja de Libreta Rasgada -->
      <section class="hero-submission-section">
        <div class="hero-text-block">
          <h1 class="section-title">
            <span class="marker-underline">LO QUE ESTE LIBRO</span><br />
            <span class="marker-underline">ME HA PROVOCADO</span>
          </h1>

          <p class="subtitle-handwritten">
            Cuéntanos cómo ha tocado tu vida este libro
          </p>

          <p class="subtitle-story-desc">
            Diez años de gente escribiéndome a las 3 a.m.<br />
            <span class="highlight-red">Ahora hay un lugar para eso.</span>
          </p>
        </div>

        <div class="hero-form-wrapper">
          <!-- Asset Hoja Rasgada Original -->
          <div class="torn-paper-card" id="openStoryModalBtn" role="button" tabindex="0" title="Haz clic para subir tu historia">
            <img 
              src="/assets/por-otro-amor/hoja-rasgada-historia.png" 
              alt="Sube tu historia - Hoja de libreta" 
              class="torn-sheet-img"
              width="460"
              height="360"
            />
            <button type="button" class="btn-marker-red btn-submit-inline">
              ENVIAR HISTORIA
            </button>
          </div>
        </div>

        <!-- Doodle Remolino -->
        <div class="doodle-swirl" aria-hidden="true">
          <img 
            src="/assets/por-otro-amor/doodle-remolino.png" 
            alt="Doodle remolino" 
            class="swirl-img"
            width="110"
            height="60"
          />
        </div>
      </section>

      <!-- Sección del Muro de Historias ("El chismecito") -->
      <section class="stories-wall-section">
        <h2 class="chismecito-title">
          Aquí puedes leer el chismecito de lxs demás
        </h2>

        <!-- Barra de Filtros y Búsqueda -->
        <div class="filters-search-bar">
          <div class="category-pills" id="categoryPills">
            {categories.map((cat, idx) => (
              <button 
                type="button" 
                class={`pill-btn ${idx === 0 ? 'active' : ''}`}
                data-filter={cat.toLowerCase()}
              >
                {cat}
              </button>
            ))}
          </div>

          <div class="search-input-wrapper">
            <input 
              type="text" 
              id="storySearchInput" 
              placeholder="Buscar por palabra o ciudad..." 
              class="story-search-field"
              aria-label="Buscar historias"
            />
            <span class="search-icon" aria-hidden="true">🔍</span>
          </div>
        </div>

        <!-- Cuadrícula de Tarjetas de Historias -->
        <div class="stories-grid" id="storiesGrid">
          {stories.map((item, index) => (
            <StoryCard 
              categoria={item.acf.categoria}
              texto={item.content.rendered}
              firma={item.acf.firma}
              index={index}
            />
          ))}
        </div>

        <!-- Paginación con Flechas (< >) -->
        <div class="pagination-controls">
          <button type="button" class="nav-arrow-btn" id="prevPageBtn" aria-label="Anterior">&lt;</button>
          <button type="button" class="nav-arrow-btn" id="nextPageBtn" aria-label="Siguiente">&gt;</button>
        </div>
      </section>

      <!-- Sección Frase de Amalia -->
      <div class="amalia-quote-section">
        <img 
          src="/assets/por-otro-amor/frase-amalia-rotulo.png" 
          alt="Frase de Amalia" 
          class="quote-rotulo-img"
          width="290"
          height="100"
        />
        <blockquote class="quote-text-block">
          <p>"El amor no es algo que se encuentra, es algo que se construye (y a veces, se deconstruye para volver a empezar)."</p>
        </blockquote>
      </div>

      <!-- Botón Ver Opciones de Compra -->
      <div class="purchase-cta-block">
        <a href="/compra" class="btn-pill-action">
          Ver opciones de compra
        </a>
      </div>
    </main>

    <!-- Modal de Envío de Historias -->
    <dialog class="story-modal-dialog" id="storyModalDialog">
      <div class="modal-inner-sheet">
        <button class="modal-close-btn" id="closeStoryModalBtn" aria-label="Cerrar modal">✕</button>

        <h2 class="modal-title">Cuéntanos tu historia</h2>
        <p class="modal-subtitle">Diez años de gente escribiéndome a las 3 a.m. Ahora hay un lugar para eso.</p>

        <form id="submitStoryForm" class="notebook-story-form">
          <div class="form-group">
            <label for="storyCategory">Categoría:</label>
            <select id="storyCategory" name="categoria" required class="notebook-select">
              <option value="DUELO">Duelo</option>
              <option value="MUDANZAS">Mudanzas</option>
              <option value="AMISTAD">Amistad</option>
              <option value="DESAMOR">Desamor</option>
              <option value="CRECIMIENTO">Crecimiento</option>
            </select>
          </div>

          <div class="form-group">
            <label for="storyContent">Tu recuerdo o historia:</label>
            <textarea 
              id="storyContent" 
              name="historia" 
              rows="4" 
              required 
              placeholder="Escribe aquí tu pedacito de vida..."
              class="notebook-textarea"
              maxlength="400"
            ></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="storyAuthor">Nombre o apodo:</label>
              <input type="text" id="storyAuthor" name="autor" required placeholder="Ej. Vale" class="notebook-input" />
            </div>
            <div class="form-group">
              <label for="storyAge">Edad:</label>
              <input type="text" id="storyAge" name="edad" placeholder="Ej. 34" class="notebook-input" />
            </div>
            <div class="form-group">
              <label for="storyCity">Ciudad:</label>
              <input type="text" id="storyCity" name="ciudad" required placeholder="Ej. Medellín" class="notebook-input" />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-marker-red">
              ENVIAR HISTORIA
            </button>
          </div>

          <div class="form-status" id="formStatusMsg" aria-live="polite"></div>
        </form>
      </div>
    </dialog>

    <Footer />
  </div>
</Layout>

<style>
  .stories-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-x: hidden;
  }

  .stories-main {
    flex: 1;
    max-width: 1300px;
    margin: 0 auto;
    width: 100%;
    padding: 1rem 2.5rem 3rem 2.5rem;
  }

  .hero-submission-section {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
    margin-top: 1rem;
    margin-bottom: 3rem;
    position: relative;
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .section-title {
    font-family: var(--font-amalia);
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    line-height: 1.2;
    color: var(--color-marker-red);
    letter-spacing: 0.03em;
    font-weight: 400;
  }

  .subtitle-handwritten {
    font-family: var(--font-handwriting);
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    color: var(--color-ink-black);
    font-weight: 700;
  }

  .subtitle-story-desc {
    font-family: var(--font-notes);
    font-size: 1.2rem;
    color: var(--color-ink-muted);
    line-height: 1.5;
  }

  .highlight-red {
    color: var(--color-marker-red);
    font-weight: bold;
  }

  .hero-form-wrapper {
    display: flex;
    justify-content: center;
  }

  .torn-paper-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .torn-paper-card:hover {
    transform: scale(1.02);
  }

  .torn-sheet-img {
    width: 100%;
    max-width: 440px;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  .btn-submit-inline {
    width: 100%;
    max-width: 420px;
    margin-top: 0.6rem;
  }

  .doodle-swirl {
    position: absolute;
    top: 8%;
    right: -10px;
    width: 100px;
    pointer-events: none;
  }

  .swirl-img {
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
  }

  /* Muro de Historias */
  .stories-wall-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    margin: 2.5rem 0;
  }

  .chismecito-title {
    font-family: var(--font-handwriting);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    color: var(--color-ink-black);
    text-align: center;
    font-weight: 700;
  }

  .filters-search-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .category-pills {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .pill-btn {
    font-family: var(--font-amalia);
    font-size: 1.1rem;
    padding: 0.4rem 1.1rem;
    border-radius: 20px;
    border: 1.5px solid var(--color-marker-red);
    color: var(--color-marker-red);
    background: transparent;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .pill-btn:hover,
  .pill-btn.active {
    background-color: var(--color-marker-red);
    color: #FFFFFF;
  }

  .search-input-wrapper {
    position: relative;
    min-width: 260px;
  }

  .story-search-field {
    width: 100%;
    padding: 0.5rem 2.2rem 0.5rem 0.9rem;
    border: 1.5px solid #d4c8b6;
    border-radius: 20px;
    background: var(--color-paper-light);
    font-family: var(--font-notes);
    font-size: 1rem;
    outline: none;
  }

  .search-icon {
    position: absolute;
    right: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.9rem;
    pointer-events: none;
    opacity: 0.6;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.8rem;
    width: 100%;
    margin-top: 1rem;
  }

  .pagination-controls {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .nav-arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--color-marker-red);
    background: transparent;
    color: var(--color-marker-red);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-amalia);
    font-size: 1.5rem;
    transition: all 0.2s ease;
  }

  .nav-arrow-btn:hover {
    background: var(--color-marker-red);
    color: #FFFFFF;
  }

  /* Frase de Amalia */
  .amalia-quote-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 3.5rem 0 2.5rem 0;
    text-align: center;
  }

  .quote-rotulo-img {
    height: 70px;
    width: auto;
    display: block;
    mix-blend-mode: multiply;
    margin-bottom: 1.2rem;
  }

  .quote-text-block {
    max-width: 680px;
    font-family: var(--font-notes);
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--color-ink-black);
    font-style: italic;
  }

  .purchase-cta-block {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  /* Modal */
  .story-modal-dialog {
    border: none;
    border-radius: 8px;
    padding: 0;
    background: transparent;
    max-width: 600px;
    width: 90vw;
    margin: auto;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }

  .story-modal-dialog::backdrop {
    background: rgba(30, 20, 15, 0.6);
    backdrop-filter: blur(4px);
  }

  .modal-inner-sheet {
    background: #FAF6ED;
    padding: 2.2rem;
    border-radius: 8px;
    border: 2px solid var(--color-paper-dark);
    position: relative;
  }

  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    font-size: 1.5rem;
    color: var(--color-ink-muted);
  }

  .modal-title {
    font-family: var(--font-amalia);
    font-size: 2rem;
    color: var(--color-marker-red);
    margin-bottom: 0.3rem;
  }

  .modal-subtitle {
    font-family: var(--font-notes);
    font-size: 1.1rem;
    color: var(--color-ink-muted);
    margin-bottom: 1.5rem;
  }

  .notebook-story-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .form-group label {
    font-family: var(--font-notes);
    font-size: 1.1rem;
    font-weight: bold;
  }

  .notebook-input,
  .notebook-select,
  .notebook-textarea {
    font-family: var(--font-notes);
    font-size: 1.1rem;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid #d4c8b6;
    border-radius: 6px;
    background: #FFFFFF;
    outline: none;
  }

  .form-row {
    display: grid;
    grid-template-columns: 2fr 1fr 2fr;
    gap: 0.8rem;
  }

  .form-actions {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .form-status {
    text-align: center;
    font-family: var(--font-handwriting);
    font-size: 1.2rem;
    color: var(--color-marker-red);
  }

  @media (max-width: 960px) {
    .hero-submission-section {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }
    .stories-grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .filters-search-bar {
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('storyModalDialog') as HTMLDialogElement;
    const openCard = document.getElementById('openStoryModalBtn');
    const closeBtn = document.getElementById('closeStoryModalBtn');
    const form = document.getElementById('submitStoryForm') as HTMLFormElement;
    const statusMsg = document.getElementById('formStatusMsg');
    const pills = document.querySelectorAll('.pill-btn');
    const searchInput = document.getElementById('storySearchInput') as HTMLInputElement;
    const cards = document.querySelectorAll('.story-note-card') as NodeListOf<HTMLElement>;

    openCard?.addEventListener('click', () => dialog?.showModal());
    closeBtn?.addEventListener('click', () => dialog?.close());

    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      if (
        e.clientY < rect.top ||
        e.clientY > rect.bottom ||
        e.clientX < rect.left ||
        e.clientX > rect.right
      ) {
        dialog.close();
      }
    });

    let currentFilter = 'todas';
    let searchQuery = '';

    const filterStories = () => {
      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const text = card.textContent?.toLowerCase() || '';
        const matchesCat = currentFilter === 'todas' || cat === currentFilter;
        const matchesSearch = searchQuery === '' || text.includes(searchQuery);
        card.style.display = matchesCat && matchesSearch ? 'flex' : 'none';
      });
    };

    pills.forEach((btn) => {
      btn.addEventListener('click', () => {
        pills.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'todas';
        filterStories();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      filterStories();
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!statusMsg) return;
      statusMsg.textContent = 'Guardando historia... ✨';
      setTimeout(() => {
        statusMsg.textContent = '¡Historia enviada con éxito! Pasará a moderación.';
        form.reset();
        setTimeout(() => {
          dialog?.close();
          statusMsg.textContent = '';
        }, 2000);
      }, 600);
    });
  });
</script>
